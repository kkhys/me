{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":prHourlyLimitNone", ":timezone(Asia/Tokyo)"],
  "schedule": ["after 1am and before 6am"],
  "dependencyDashboard": true,
  "assignees": ["kkhys"],
  "labels": ["type: bump-version"],
  "assignAutomerge": true,
  "minimumReleaseAge": "1 day",
  "rebaseWhen": "behind-base-branch",
  "packageRules": [
    {
      "matchDepTypes": ["devDependencies"],
      "automerge": true
    },
    {
      "matchDepTypes": ["dependencies"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "matchDepTypes": ["pnpm.catalog.default"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "TypeScript 7 is the native (tsgo) rewrite and no longer exposes the legacy compiler API that @astrojs/language-server needs for `astro check`. Lift once the language server supports it.",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    },
    {
      "description": "astro-expressive-code and its plugins ship in lockstep at one version and are not in Renovate's monorepo presets, so they stay grouped to keep the lockfile on a single version.",
      "groupName": "Expressive Code",
      "matchPackageNames": ["astro-expressive-code", "@expressive-code/**"],
      "automerge": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Bump the gh-actions-lock extension pinned in verify-lockfile.yml.",
      "managerFilePatterns": ["/^\\.github/workflows/verify-lockfile\\.yml$/"],
      "matchStrings": [
        "gh extension install github/gh-actions-lock --pin (?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "github/gh-actions-lock",
      "datasourceTemplate": "github-releases"
    }
  ]
}
