{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "kkhys",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "test": "pnpm -r test",
    "coverage": "pnpm -r coverage",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt",
    "build:me": "pnpm --filter @kkhys/me build",
    "dev:me": "pnpm --filter @kkhys/me dev",
    "deploy:me": "pnpm --filter @kkhys/me run deploy",
    "build:lgtm": "pnpm --filter @kkhys/lgtm build",
    "dev:lgtm": "pnpm --filter @kkhys/lgtm dev",
    "deploy:lgtm": "pnpm --filter @kkhys/lgtm run deploy",
    "build:diary": "pnpm --filter @kkhys/diary build",
    "dev:diary": "pnpm --filter @kkhys/diary dev",
    "deploy:diary": "pnpm --filter @kkhys/diary run deploy",
    "build:memo": "pnpm --filter @kkhys/memo build",
    "dev:memo": "pnpm --filter @kkhys/memo dev",
    "build:trends": "pnpm --filter @kkhys/trends build",
    "dev:trends": "pnpm --filter @kkhys/trends dev",
    "deploy:trends": "pnpm --filter @kkhys/trends run deploy",
    "build:design": "pnpm --filter @kkhys/design build",
    "dev:design": "pnpm --filter @kkhys/design dev",
    "deploy:design": "pnpm --filter @kkhys/design run deploy",
    "build:art": "pnpm --filter @kkhys/art build",
    "dev:art": "pnpm --filter @kkhys/art dev",
    "deploy:art": "pnpm --filter @kkhys/art run deploy",
    "dev:studio": "pnpm --filter @kkhys/studio dev",
    "release": "bun run scripts/release.ts"
  },
  "devDependencies": {
    "@kkhys/release": "workspace:*",
    "oxfmt": "catalog:",
    "oxlint": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.24.0"
}
