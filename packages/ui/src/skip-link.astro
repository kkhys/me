---
/* First focusable element on the page. Invisible until it receives keyboard
   focus, then pinned to the top-left corner so keyboard and screen-reader
   users can jump past the site chrome to the page's `<main id="main">`. */
interface Props {
  /** Target fragment; the layout's main element id. */
  href?: string | undefined;
  /** Link text in the page's language, e.g. 本文へ移動 / Skip to content. */
  label: string;
}

const { href = "#main", label } = Astro.props;
---

<a href={href} class="skip-link">{label}</a>

<style>
  .skip-link {
    position: fixed;
    top: var(--space-2);
    left: var(--space-2);
    z-index: 100;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
    background: var(--c-bg);
    color: var(--c-text);
    font-size: var(--fs-sm);
    text-decoration: none;
    box-shadow: var(--shadow-sm);
  }

  /* The .sr-only recipe from base.css, inlined so the link does not depend
     on the shared class being present. */
  .skip-link:not(:focus) {
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
