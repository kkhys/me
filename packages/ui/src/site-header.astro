---
import ArrowLeftIcon from "./icons/arrow-left.svg";

interface Props {
  title: string;
  /** Renders the title as a link (the lgtm brand-link pattern). */
  href?: string | undefined;
  /** Shows a back-to-home button on the left (the memo subpage pattern). */
  showBack?: boolean | undefined;
  /** Accessible name of the back button, in the page's language. */
  backLabel?: string | undefined;
  /** Renders the title as the page's h1 (for pages that have no other h1). */
  heading?: boolean | undefined;
}

const { title, href, showBack = false, backLabel = "Back to home", heading = false } = Astro.props;
---

<header class="site-header">
  {
    showBack && (
      <a href="/" class="back-button" aria-label={backLabel}>
        <ArrowLeftIcon width={14} height={14} />
      </a>
    )
  }
  {
    heading ? (
      <h1 class="site-title">{href ? <a href={href}>{title}</a> : title}</h1>
    ) : href ? (
      <a href={href} class="site-title">{title}</a>
    ) : (
      <div class="site-title">{title}</div>
    )
  }
  {
    /* `actions`: controls pinned to the right edge, opposite the back button. */
    Astro.slots.has("actions") && (
      <div class="site-header-actions">
        <slot name="actions" />
      </div>
    )
  }
</header>

<style>
  /* Expects the consumer's body grid to define [top] / [main-start] rows
     (the memo / lgtm / design layout shells); harmless elsewhere. */
  .site-header {
    position: relative;
    display: grid;
    grid-row: top / main-start;
    justify-items: center;
    align-items: center;
    width: 100%;
    padding-block: var(--space-4);
  }

  .site-title {
    margin: 0;
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
  }

  a.site-title,
  .site-title a {
    text-decoration: none;
    color: inherit;
    transition: color 0.2s;
  }

  /* The title rests at --c-text, so the hover lightness shift runs the other
     way (to --c-sub) rather than dimming with opacity. */
  a.site-title:hover,
  .site-title a:hover {
    color: var(--c-sub);
  }

  .back-button {
    position: absolute;
    left: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: var(--radius-full);
    color: var(--c-text);
    transition: background-color 0.15s;
  }

  .back-button:hover {
    background-color: var(--c-surface);
  }

  .site-header-actions {
    position: absolute;
    right: 0;
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
</style>
