---
import { getImage, Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import { blurLoadHandlers } from "./blur-load";

/* Blur-up picture: a 20px placeholder sits behind the real image, blurred,
   until the image loads (or fails — see blur-load.ts). The wrapper reserves
   the aspect ratio so nothing shifts. Consumers style the frame through
   `radius` / `framed` rather than reaching into the markup. */
interface Props {
  src: ImageMetadata;
  alt: string;
  /** Candidate widths; Astro drops any beyond the source width, so listing up to 2x is safe. */
  widths: number[];
  sizes: string;
  /** Intrinsic width attribute (CSS px); defaults to the source width. */
  width?: number | undefined;
  formats?: ("avif" | "webp")[] | undefined;
  quality?: number | undefined;
  priority?: boolean | undefined;
  /** Shared between a thumbnail and its detail page so the image morphs across the navigation. */
  transitionName?: string | undefined;
  /** Hairline frame for images that would otherwise merge with the page. */
  framed?: boolean | undefined;
  /** Corner radius, any CSS length. */
  radius?: string | undefined;
  class?: string | undefined;
}

const {
  src,
  alt,
  widths,
  sizes,
  width = src.width,
  formats = ["avif", "webp"],
  quality = 80,
  priority = false,
  transitionName,
  framed = false,
  radius,
  class: className,
} = Astro.props;

const blurryImage = await getImage({ src, width: 20 });

const style = [
  `--bg-image: url(${blurryImage.src})`,
  `--aspect-ratio: ${src.width} / ${src.height}`,
  radius === undefined ? undefined : `--blur-radius: ${radius}`,
  transitionName === undefined ? undefined : `view-transition-name: ${transitionName}`,
]
  .filter((declaration) => declaration !== undefined)
  .join("; ");
---

<div class:list={["blur-image", { "blur-image--framed": framed }, className]} style={style}>
  <div class="blur-load">
    <Picture
      src={src}
      alt={alt}
      width={width}
      formats={formats}
      quality={quality}
      widths={widths}
      sizes={sizes}
      loading={priority ? "eager" : "lazy"}
      fetchpriority={priority ? "high" : undefined}
      {...blurLoadHandlers(".blur-load")}
    />
  </div>
</div>

<style>
  .blur-image {
    overflow: clip;
    aspect-ratio: var(--aspect-ratio);
    border-radius: var(--blur-radius, 0);
  }

  .blur-image--framed {
    box-shadow: 0 0 0 1px var(--c-border);
  }

  .blur-load {
    background: var(--bg-image) center / cover no-repeat;
    filter: blur(36px);
    transition: filter 250ms ease-in-out;
  }

  .blur-load.image-loaded {
    background: none;
    filter: blur(0);
  }

  .blur-load :global(picture) {
    display: block;
  }

  .blur-load :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
