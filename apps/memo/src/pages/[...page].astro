---
import type { GetStaticPaths } from "astro";
import PaginatedFeed from "#/components/paginated-feed.astro";
import BaseSEO from "#/components/seo/base-seo.astro";
import JsonLd from "@kkhys/seo/json-ld.astro";
import OpenGraph from "#/components/seo/open-graph.astro";
import TwitterCard from "#/components/seo/twitter-card.astro";
import ThreadPost from "#/components/thread-post.astro";
import {
  DESCRIPTION,
  PAGE_SIZE,
  SITE_OWNER_SLUG,
  TITLE,
} from "#/config/constants";
import Layout from "#/layouts/layout.astro";
import { getMemosWithCommentsAndPinned } from "#/utils/memo";
import { getAuthorInfo } from "#/utils/user";

export const getStaticPaths = (async ({ paginate }) => {
  const { pinned, memos } = await getMemosWithCommentsAndPinned();

  return paginate(memos, { pageSize: PAGE_SIZE, props: { pinned } });
}) satisfies GetStaticPaths;

const { page, pinned } = Astro.props;
const isFirstPage = page.currentPage === 1;
const siteOwner = await getAuthorInfo(SITE_OWNER_SLUG);
const ogImage = new URL("/api/og/default.png", Astro.site).href;
---

<Layout>
  <Fragment slot="seo">
    <BaseSEO title={TITLE} description={DESCRIPTION} noindex={!isFirstPage} />
    <OpenGraph title={TITLE} description={DESCRIPTION} type="website" image={ogImage} imageAlt={TITLE} />
    <TwitterCard title={TITLE} description={DESCRIPTION} image={ogImage} imageAlt={TITLE} />
  </Fragment>

  <Fragment slot="structured-data">
    <JsonLd
      type="WebSite"
      data={{
        name: TITLE,
        description: DESCRIPTION,
        author: {
          "@type": "Person",
          name: siteOwner.name,
        },
      }}
    />
  </Fragment>
  <PaginatedFeed page={page} basePath="/" containerId="memo-container">
    {
      isFirstPage && pinned.map(({ main, comments }) => (
        <ThreadPost
          memo={main}
          comments={comments}
          isPinned={true}
        />
      ))
    }
    {
      page.data.map(({ main, comments }) => (
        <ThreadPost
          memo={main}
          comments={comments}
        />
      ))
    }
  </PaginatedFeed>
</Layout>
