---
import SearchDialog from "@kkhys/search/dialog.astro";
import { searchConfig } from "#/features/search/config";
---

<SearchDialog id={searchConfig.dialogId} label="メモを検索" placeholder="メモを検索">
  <Fragment slot="template">
    <template class="search-result-template">
      <li class="search-results-item">
        <a class="search-result" data-umami-event="search-result">
          <img class="search-result-avatar" alt="" width="27" height="27" loading="lazy" decoding="async" />
          <span class="search-result-body">
            <span class="search-result-header">
              <span class="search-result-author"></span>
              <time class="search-result-date"></time>
            </span>
            <span class="search-result-excerpt"></span>
          </span>
        </a>
      </li>
    </template>
  </Fragment>
</SearchDialog>

<style>
  .search-results-item {
    margin: 0;
    padding: 0;
  }

  /* Laid out like a feed post: avatar column, then author / date over the
     excerpt, so a hit reads the same way it will on the thread page. */
  .search-result {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    font-size: var(--fs-sm);
    color: var(--c-text);
    text-decoration: none;
    transition: background-color 0.2s;
  }

  .search-result:hover {
    background-color: oklch(from var(--c-surface) l c h / 50%);
  }

  /* The list clips overflow, so keep the ring inside the row. */
  .search-result:focus-visible {
    outline: var(--ring-width) solid var(--ring);
    outline-offset: calc(-1 * var(--ring-width));
  }

  .search-result-avatar {
    flex-shrink: 0;
    width: 27px;
    height: 27px;
    border-radius: 50%;
    object-fit: cover;
    outline: 1px solid var(--c-border);
    outline-offset: -0.5px;
  }

  .search-result-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .search-result-header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
  }

  .search-result-author {
    overflow: hidden;
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-xs);
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .search-result-date {
    flex-shrink: 0;
    font-size: var(--fs-xs);
    line-height: var(--lh-xs);
    font-variant-numeric: tabular-nums;
    color: var(--c-sub);
  }

  .search-result-excerpt {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
    line-height: var(--lh-sm);
    overflow-wrap: anywhere;
  }

  /* Not `--c-selection`: its dark-mode yellow-9 fill drowns the text, so the
     match keeps body colour and gains weight over a 35% tint instead. */
  .search-result-excerpt :global(mark) {
    padding-inline: 0.125em;
    margin-inline: -0.0625em;
    border-radius: var(--radius-xs);
    background-color: light-dark(
      var(--uchu-yellow-2),
      oklch(from var(--uchu-yellow-9) l c h / 35%)
    );
    color: var(--c-text);
    font-weight: var(--fw-medium);
  }
</style>

<script>
  import {
    isHTMLElement,
    mountSearchDialog,
    renderExcerpt,
    requireElement,
  } from "@kkhys/search/dialog-setup";
  import { toResultHref } from "@kkhys/search/query";
  import type { PagefindSearchFragment } from "@kkhys/search/types";
  import { searchConfig } from "#/features/search/config";

  const { metaKeys } = searchConfig;

  const renderResult = (fragment: PagefindSearchFragment, template: HTMLTemplateElement) => {
    const node = template.content.cloneNode(true) as DocumentFragment;
    const href = toResultHref(fragment.url);
    const authorName = fragment.meta[metaKeys.author];
    const date = fragment.meta[metaKeys.date];
    const datetime = fragment.meta[metaKeys.datetime];
    const avatar = fragment.meta[metaKeys.avatar];
    if (import.meta.env.DEV && (!authorName || !date || !datetime || !avatar)) {
      console.warn(
        "Pagefind fragment is missing expected meta; check data-pagefind-meta in thread-post",
        fragment.url,
        fragment.meta,
      );
    }

    requireElement(
      node,
      ".search-result",
      (element): element is HTMLAnchorElement => element instanceof HTMLAnchorElement,
    ).href = href;
    const image = requireElement(
      node,
      ".search-result-avatar",
      (element): element is HTMLImageElement => element instanceof HTMLImageElement,
    );
    if (avatar) image.src = avatar;
    else image.remove();
    requireElement(node, ".search-result-author", isHTMLElement).textContent = authorName ?? "";
    renderExcerpt(requireElement(node, ".search-result-excerpt", isHTMLElement), fragment.excerpt);
    const time = requireElement(
      node,
      ".search-result-date",
      (element): element is HTMLTimeElement => element instanceof HTMLTimeElement,
    );
    // `datetime=""` is not a valid value, so drop the element when the
    // fragment carries no date.
    if (date && datetime) {
      time.textContent = date;
      time.dateTime = datetime;
    } else {
      time.remove();
    }
    return node;
  };

  mountSearchDialog(searchConfig.dialogId, {
    bundlePath: searchConfig.bundlePath,
    excerptLength: searchConfig.excerptLength,
    maxResults: searchConfig.maxResults,
    debounceMs: searchConfig.debounceMs,
    noun: "メモ",
    renderResult,
  });
</script>
