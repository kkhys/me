---
interface Props {
  id?: string;
  "data-current-page"?: number;
  "data-total-pages"?: number;
  "data-base-path"?: string;
}

const {
  id,
  "data-current-page": currentPage,
  "data-total-pages": totalPages,
  "data-base-path": basePath,
} = Astro.props;
---

<div
  class="feed-container"
  id={id}
  data-current-page={currentPage}
  data-total-pages={totalPages}
  data-base-path={basePath}
>
  <slot />
</div>

<style>
  .feed-container {
    width: 100%;
    max-width: 37rem;
    margin: 0 auto;
  }
</style>
