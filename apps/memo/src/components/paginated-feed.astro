---
import InfiniteScroll from "@kkhys/ui/infinite-scroll.astro";
import PaginatedGuard from "@kkhys/ui/paginated-guard.astro";
import type { Page } from "astro";
import Feed from "#/components/feed.astro";

interface Props {
  page: Page<unknown>;
  basePath: string;
  containerId: string;
}

const { page, basePath, containerId } = Astro.props;
const isFirstPage = page.currentPage === 1;
---

{!isFirstPage && <PaginatedGuard basePath={basePath} />}

<Feed
  id={containerId}
  data-current-page={page.currentPage}
  data-total-pages={page.lastPage}
  data-base-path={basePath}
>
  <slot />
</Feed>

{page.currentPage < page.lastPage && (
  <InfiniteScroll
    containerId={containerId}
    endMessage="最後まで読み込みました \u{1F389}"
    errorMessage="読み込みに失敗しました \u{1F622}"
    loadingLabel="読み込み中"
  />
)}
