---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  size: number;
  link?: string;
}

const { src, alt, size, link } = Astro.props;
---

{link ? (
  <a href={link} class="avatar-link">
    <Image
      src={src}
      alt={alt}
      width={size}
      height={size}
      densities={[1.5, 2]}
      class="avatar"
      priority
    />
  </a>
) : (
  <Image
    src={src}
    alt={alt}
    width={size}
    height={size}
    densities={[1.5, 2]}
    class="avatar"
    priority
  />
)}

<style>
  .avatar {
    border-radius: 50%;
    object-fit: cover;
    outline: 1px solid var(--c-border);
    outline-offset: -0.5px;
    transition: outline-color 0.15s;
  }

  /* An image has no text color to shift, so hover darkens the ring instead
     of fading the picture. */
  .avatar-link:hover .avatar {
    outline-color: var(--c-sub);
  }
</style>
