---
import { type CollectionEntry, render } from "astro:content";
import Avatar from "#/components/avatar.astro";
import BotBadge from "#/components/bot-badge.astro";
import LinkCard from "#/components/link-card.astro";
import MemoImages from "#/components/memo-images.astro";
import TagLink from "#/components/tag-link.astro";
import { formatDate, formatDateTime } from "#/utils/date";
import { getImagesForMemo } from "#/utils/image";
import { getAuthorInfo } from "#/utils/user";

interface Props {
  memo: CollectionEntry<"memo">;
}

const { memo } = Astro.props;
const { id, author, createdAt, tag, hideLinkCard, isBot } = memo.data;
const { Content, remarkPluginFrontmatter } = await render(memo);

const firstExternalLink = remarkPluginFrontmatter?.firstExternalLink ?? null;

const images = getImagesForMemo(memo.id);

const {
  name: authorName,
  avatar: avatarImage,
  profileLink: authorLink,
} = await getAuthorInfo(author);

const createdAtString = formatDate(createdAt);
const fullDateTimeString = formatDateTime(createdAt);
---

<div class="quote-card" data-href={`/posts/${id}`}>
    <div class="quote-header">
        <Avatar src={avatarImage} alt={authorName} size={20} link={authorLink} />
        <a href={authorLink} class="quote-author">{authorName}</a>
        {isBot && <BotBadge />}
        <a href={`/posts/${id}`} class="quote-time-link">
            <time class="quote-time" datetime={createdAt.toISOString()} title={fullDateTimeString}>{createdAtString}</time>
        </a>
    </div>
    <div class="quote-text">
        <Content />
    </div>
    {tag && <TagLink tag={tag} />}
    <MemoImages images={images} alts={memo.data.images} />
    {!hideLinkCard && firstExternalLink && (
        <div class="quote-link-card">
            <LinkCard href={firstExternalLink} />
        </div>
    )}
</div>

<style>
    .quote-card {
        display: block;
        cursor: pointer;
        border: 1px solid var(--c-border);
        border-radius: 0.75rem;
        padding: var(--space-3);
        transition: background-color 0.15s ease;
        user-select: none;
    }

    .quote-card:hover {
        background-color: oklch(from var(--c-surface) l c h / 50%);
    }

    .quote-header {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        margin-bottom: var(--space-1);
        line-height: 1;
    }

    .quote-header :global(.avatar-link),
    .quote-header :global(.avatar) {
        display: block;
    }

    .quote-author {
        font-size: var(--fs-xs);
        font-weight: var(--fw-semibold);
        color: var(--c-text);
        text-decoration: none;
    }

    .quote-author:hover {
        text-decoration: underline;
    }

    .quote-time {
        font-size: var(--fs-xs);
        color: var(--c-sub);
        font-variant-numeric: tabular-nums;
    }

    .quote-time-link {
        text-decoration: none;
    }

    .quote-time-link:hover {
        text-decoration: underline;
    }

    :global(.quote-text p) {
        font-size: var(--fs-sm);
        line-height: var(--lh-sm);
        color: var(--c-text);
    }

    :global(.quote-text p + p) {
        margin-top: var(--space-2);
    }

    :global(.quote-text .external-link) {
        color: var(--c-link);
        text-decoration: none;
    }

    :global(.quote-text .external-link:hover) {
        text-decoration: underline;
    }

    .quote-link-card {
        margin-top: var(--space-3);
    }
</style>
