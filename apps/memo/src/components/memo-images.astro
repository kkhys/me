---
import BlurImage from "@kkhys/ui/blur-image.astro";
import type { MemoImage } from "#/utils/image";
import { type MemoImageAlt, memoImageAlt } from "#/utils/image-alt";

interface Props {
  images: MemoImage[];
  alts?: MemoImageAlt[] | undefined;
}

const { images, alts } = Astro.props;
---

{images.length > 0 && (
  <div class="memo-images">
    {images.map(({ file, src }, index) => (
      <BlurImage
        src={src}
        alt={memoImageAlt(file, index, alts)}
        formats={["avif"]}
        widths={[320, 640, 1280]}
        sizes="(min-width: 640px) 640px, 100vw"
        radius="8px"
        framed
      />
    ))}
  </div>
)}

<style>
    .memo-images {
        margin-top: var(--space-3);
    }

    /* Single image */
    .memo-images:has(> :only-child) {
        display: grid;
    }

    .memo-images:has(> :only-child) :global(.blur-image) {
        max-height: 430px;
    }

    /* Multiple images: horizontal scroll gallery */
    .memo-images:not(:has(> :only-child)) {
        display: flex;
        gap: var(--space-2);
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scrollbar-width: thin;
        scrollbar-color: var(--c-scrollbar) transparent;
        padding-bottom: var(--space-2);
    }

    .memo-images:not(:has(> :only-child)) :global(.blur-image) {
        flex: 0 0 auto;
        height: min(260px, 50vw);
        aspect-ratio: unset !important;
        scroll-snap-align: start;
    }

    .memo-images:not(:has(> :only-child)) :global(.blur-load) {
        height: 100%;
    }

    .memo-images:not(:has(> :only-child)) :global(.blur-load picture) {
        height: 100%;
    }

    .memo-images:not(:has(> :only-child)) :global(.blur-load img) {
        width: auto;
        height: 100%;
    }
</style>
