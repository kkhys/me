---
import type { InferEntrySchema } from "astro:content";
import BotBadge from "#/components/bot-badge.astro";
import { buildAuthorMeta, buildDateMeta } from "#/features/search/utils/meta";
import { formatDate, formatDateTime } from "#/utils/date";

interface Props extends Pick<InferEntrySchema<"memo">, "author" | "createdAt"> {
  authorLink?: string | undefined;
  /** Makes the date a link to the post, so a feed card is reachable by keyboard. */
  postLink?: string | undefined;
  isBot?: boolean | undefined;
  /** Exposes the author name and date to Pagefind as result metadata. */
  indexable?: boolean | undefined;
}

const { author, createdAt, authorLink, postLink, isBot = false, indexable = false } = Astro.props;
const createdAtString = formatDate(createdAt);
const fullDateTimeString = formatDateTime(createdAt);
const authorMeta = indexable ? buildAuthorMeta() : undefined;
const dateMeta = indexable ? buildDateMeta() : undefined;
---

<div class="post-header">
    {authorLink ? (
        <a href={authorLink} class="post-username-link" data-pagefind-meta={authorMeta}>
            {author}
        </a>
    ) : (
        <span class="post-username" data-pagefind-meta={authorMeta}>{author}</span>
    )}
    {isBot && <BotBadge />}
    {postLink ? (
        <a href={postLink} class="post-time-link">
            <time
                class="post-time"
                datetime={createdAt.toISOString()}
                title={fullDateTimeString}
                data-pagefind-meta={dateMeta}
                >{createdAtString}</time
            >
        </a>
    ) : (
        <time
            class="post-time"
            datetime={createdAt.toISOString()}
            title={fullDateTimeString}
            data-pagefind-meta={dateMeta}
            >{createdAtString}</time
        >
    )}
</div>

<style>
    .post-header {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        margin-bottom: 0.15rem;
    }

    .post-username-link:hover {
        text-decoration: underline;
    }

    .post-username, .post-username-link {
        font-size: var(--fs-xs);
        font-weight: var(--fw-semibold);
        color: var(--c-text);
    }

    .post-time {
        font-size: var(--fs-xs);
        color: var(--c-sub);
        font-variant-numeric: tabular-nums;
    }

    .post-time-link {
        text-decoration: none;
    }

    .post-time-link:hover {
        text-decoration: underline;
    }
</style>
