---
import SiteHeader from "@kkhys/ui/site-header.astro";

const currentPath = Astro.url.pathname;
const isHomePage = currentPath === "/" || currentPath === "/index.html";

const PATH_RULES = [
  {
    match: (p: string) => p === "/" || p === "/index.html",
    getTitle: () => "Memo",
  },
  {
    match: (p: string) => p.startsWith("/tag/"),
    getTitle: (p: string) => {
      const tagName = p
        .replace("/tag/", "")
        .replace(/\/$/u, "")
        .replace(/\.html$/u, "");
      return tagName ? `#${tagName}` : "Tag";
    },
  },
  { match: (p: string) => p.startsWith("/posts/"), getTitle: () => "Thread" },
  {
    match: (p: string) => p.startsWith("/@"),
    getTitle: () => "Profile",
  },
] as const;

const getHeaderTitle = (path: string) =>
  PATH_RULES.find((r) => r.match(path))?.getTitle(path) ?? "Memo";

const headerTitle = getHeaderTitle(currentPath);
const showBackButton = !isHomePage;
---

<SiteHeader title={headerTitle} showBack={showBackButton} />
