---
import { type Favicon, getFavicon } from "@kkhys/ui/favicon";
import LinkCard from "@kkhys/ui/link-card.astro";
import type { HTMLAttributes } from "astro/types";
import { getMetadata } from "#/lib/metadata";

interface Props extends HTMLAttributes<"a"> {
  href: string;
}

const props = Astro.props;

const { title, description, image, icon } = await getMetadata(props.href);

const favicon: Favicon = icon ? await getFavicon(icon) : { kind: "none" };
---

<LinkCard
  {...props}
  title={title}
  description={description}
  imageSrc={image?.src}
  favicon={favicon}
  external
/>
