{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@kkhys/trends",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt",
    "deploy": "pnpm build && wrangler pages deploy dist --project-name=trends",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "all": "pnpm build && pnpm check && pnpm lint:fix && pnpm test && pnpm coverage"
  },
  "dependencies": {
    "@astrojs/compiler-rs": "catalog:",
    "@kkhys/og": "workspace:*",
    "@kkhys/seo": "workspace:*",
    "@kkhys/styles": "workspace:*",
    "astro": "catalog:",
    "budoux": "0.9.0",
    "kiso.css": "catalog:",
    "linkedom": "0.18.13",
    "sharp": "catalog:"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "@astrojs/sitemap": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
