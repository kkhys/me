---
import SiteHeader from "#/components/site-header.astro";
import BaseLayout from "#/layouts/base-layout.astro";

/* JSX text keeps source line breaks as spaces, which show up mid-sentence in
   Japanese copy — so every paragraph below stays on a single line. */
const SKILL_URL =
  "https://github.com/kkhys/claude-code-marketplace/tree/main/plugins/base/skills/creating-trend-digest";

const scoreIntro =
  "記事の並び順は、このスコアの降順だけで決まります。スコアは「そのソース内での相対的な盛り上がり」を表し、次の2つの加重平均です。";
const scoreItems = [
  {
    term: "エンゲージメント（75%）",
    description:
      "同じソース・同じ日の記事集合の中でのパーセンタイル。指標はソースごとに異なり、Hacker News / Lobsters は points とコメント数、はてなブックマークはブックマーク数、Zenn はいいねとブクマ、Qiita は LGTM とストック、dev.to はリアクションとコメント、GitHub Trending は当日のスター増加数、Hugging Face Daily Papers は upvote とコメント数を使います。カウント指標のない Reddit と Techmeme は、それぞれの一覧での掲載順位（Reddit の top ランキング / Techmeme の編集部による掲載順）をそのまま使います。",
  },
  {
    term: "鮮度（25%）",
    description: "公開からの経過時間による減衰。",
  },
];
const scoreNote =
  "単位の違うソースを絶対値で比べず、ソース内の相対評価に正規化しているため、サービス間でスコアを直接比較することはできません。表示の濃淡は 80以上 / 60以上 / それ未満の3段階です。";

const starsIntro =
  "タイトルの下に付く星は、運営者の興味プロフィールと記事のテーマがどの程度合っているかを示す注釈です。";
const starsNote =
  "星は並び順に影響しません。一覧は世間のトレンドをそのまま映し、個人の興味は星の注釈と冒頭のハイライトの選定にだけ反映されます。なお、除外テーマに該当する記事は掲載されません。";

const glossary = [
  {
    term: "既出",
    description:
      "過去の日のダイジェストに掲載済みのURL。減点はせず、掲載が続くこと自体を勢いのシグナルとみなしています。",
  },
  {
    term: "カテゴリ",
    description: "興味プロフィールのテーマから付けた短いラベル（AI/開発 など）。",
  },
  {
    term: "コメントの要約",
    description:
      "Hacker News / Lobsters / Reddit / はてなブックマークの記事に付く折りたたみ。記事の概要と、コメント欄の主な論点や意見の分かれ方を2-3段落でまとめています。",
  },
  {
    term: "記事の要約",
    description:
      "GitHub Trending / dev.to / Zenn / Qiita / Hugging Face Daily Papers の記事に付く折りたたみ。コメント欄の取得に対応していないソースのため、代わりに記事本文（README や論文アブストラクト）の要点を2-3段落でまとめています。なお Techmeme は見出しと概要が記事の要点を兼ねるため、折りたたみは付きません。",
  },
  {
    term: "ハイライト",
    description:
      "ページ冒頭の3-5件。複数ソースへの同時登場や突出したエンゲージメントなど、その日に観測されたシグナルに基づいて選んでいます。",
  },
];
---

<BaseLayout
  title="About | Trend Digest"
  description="Trend Digest の仕組みと、スコア・星の基準について"
>
  <SiteHeader />
  <main class="wrap" id="main">
    <h1 class="page-title">About</h1>
    <p>Trend Digest は、10のソースの技術トレンドを1日1回集計し、日ごとのダイジェストとして掲載する <a href="https://kkhys.me" target="_blank" rel="noreferrer">kkhys</a> の個人サイトです。グローバル（Hacker News / Lobsters / Reddit / GitHub Trending / dev.to / Techmeme / Hugging Face Daily Papers）と日本（はてなブックマーク / Zenn / Qiita）に分けて、各ソースの上位記事と要約、その日の総括を載せています。要約とハイライトの選定は Claude が行っています。</p>
    <p>投稿は不定期です。ダイジェストは Claude Code の <a href={SKILL_URL} target="_blank" rel="noreferrer">creating-trend-digest</a> スキルを手動で実行して生成・公開しているため、実行しなかった日の分はありません。</p>

    <section>
      <h2>スコア（0-100）</h2>
      <p>{scoreIntro}</p>
      <dl class="glossary">
        {
          scoreItems.map(({ term, description }) => (
            <>
              <dt>{term}</dt>
              <dd>{description}</dd>
            </>
          ))
        }
      </dl>
      <p>{scoreNote}</p>
    </section>

    <section>
      <h2>星（★1-3）</h2>
      <p>{starsIntro}</p>
      <dl class="legend">
        <dt><span class="stars">★★★</span></dt>
        <dd>関心の高いテーマに合致</dd>
        <dt><span class="stars">★★</span></dt>
        <dd>中程度のテーマに合致</dd>
        <dt><span class="stars">★</span></dt>
        <dd>合致が弱い、または該当なし</dd>
      </dl>
      <p>{starsNote}</p>
    </section>

    <section>
      <h2>その他の表示</h2>
      <dl class="glossary">
        {
          glossary.map(({ term, description }) => (
            <>
              <dt>{term}</dt>
              <dd>{description}</dd>
            </>
          ))
        }
      </dl>
    </section>
  </main>
</BaseLayout>

<style>
  .wrap {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 0 var(--space-4) 3.5rem;
  }

  /* Same rhythm as apps/me: below 640px the column keeps 1rem side padding,
     above it the full 42rem is used. */
  @media (width >= 640px) {
    .wrap {
      padding-inline: 0;
    }
  }

  .page-title {
    margin: var(--space-8) 0 var(--space-6);
    font-size: 1rem;
    font-weight: var(--fw-medium);
  }

  section {
    margin-top: 2.5rem;
  }

  h2 {
    margin: 0 0 var(--space-1);
    padding-bottom: 0.625rem;
    border-bottom: 1px solid var(--c-border);
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
  }

  p {
    margin: var(--space-3) 0 0;
    font-size: var(--fs-sm);
    line-height: 1.9;
  }

  p a {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  dl {
    margin: var(--space-4) 0 0;
    font-size: var(--fs-sm);
    line-height: 1.9;
  }

  dt {
    margin: 0;
    white-space: nowrap;
  }

  dd {
    margin: 0;
    min-width: 0;
  }

  .legend {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 1.25rem;
    row-gap: var(--space-2);
  }

  /* Terms are long enough that a second column would starve the description
     on narrow screens, so the glossary stacks below 640px. */
  .glossary dt {
    color: var(--c-sub);
  }

  .glossary dd + dt {
    margin-top: var(--space-3);
  }

  @media (width >= 640px) {
    .glossary {
      display: grid;
      grid-template-columns: auto 1fr;
      column-gap: 1.25rem;
      row-gap: var(--space-2);
    }

    .glossary dd + dt {
      margin-top: 0;
    }
  }

  .stars {
    color: var(--c-star);
    letter-spacing: 1px;
  }
</style>
