---
import { getCollection } from "astro:content";

import DigestView from "#/components/digest-view.astro";
import SiteHeader from "#/components/site-header.astro";
import BaseLayout from "#/layouts/base-layout.astro";
import { sortRunsByDateDesc } from "#/utils/runs";

const runs = sortRunsByDateDesc(await getCollection("runs"));
const latest = runs[0];

if (!latest) {
  throw new Error("No digest runs found in src/content/runs");
}
---

<BaseLayout description={latest.data.digest.headline}>
  <SiteHeader />
  <DigestView entry={latest} prev={runs[1]?.id} next={undefined} />
</BaseLayout>
