---
import SearchDialog from "@kkhys/search/dialog.astro";
import { searchConfig } from "#/features/search/config";

/* This site's Pagefind dialog: the shared shell from @kkhys/search with a
   result row that names the day and the row (item heading) the hit sits in,
   and a 関連度 / 新しい順 toggle under the field. */
---

<SearchDialog id={searchConfig.dialogId} label="記事を検索" placeholder="記事を検索">
  <div slot="filters" class="search-sort" role="group" aria-label="並び順">
    <button
      type="button"
      data-sort="relevance"
      aria-pressed="true"
      data-umami-event="search-sort"
      data-umami-event-mode="relevance"
    >
      関連度
    </button>
    <span class="sep" aria-hidden="true">/</span>
    <button
      type="button"
      data-sort="date"
      aria-pressed="false"
      data-umami-event="search-sort"
      data-umami-event-mode="date"
    >
      新しい順
    </button>
  </div>
  <Fragment slot="template">
    <template class="search-result-template">
      <li class="search-results-item">
        <a class="search-result" data-umami-event="search-result">
          <span class="search-result-heading">
            <time class="search-result-date"></time>
            <span class="search-result-title palt"></span>
          </span>
          <span class="search-result-excerpt"></span>
        </a>
      </li>
    </template>
  </Fragment>
</SearchDialog>

<style>
  /* Same text toggle as the 既出 filter in the toolbar: the pressed choice
     in body colour and weight, the other in --c-sub. */
  .search-sort {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    padding: 0 var(--space-4) var(--space-3);
    font-size: var(--fs-xs);
    color: var(--c-sub);
  }

  .search-sort button {
    position: relative;
    appearance: none;
    border: 0;
    background: none;
    padding: 0;
    font: inherit;
    color: inherit;
    cursor: pointer;
    transition: color 0.2s;
  }

  /* Text-only buttons are 18px tall; extend the hit area to the 24px
     WCAG 2.5.8 minimum without changing the visual. */
  .search-sort button::before {
    content: "";
    position: absolute;
    inset: -0.25rem 0;
  }

  .search-sort button:hover {
    color: var(--c-text);
  }

  .search-sort button[aria-pressed="true"] {
    color: var(--c-text);
    font-weight: var(--fw-medium);
  }

  .search-sort .sep {
    color: var(--c-faint);
  }

  .search-results-item {
    margin: 0;
    padding: 0;
  }

  .search-result {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    font-size: var(--fs-sm);
    color: var(--c-text);
    text-decoration: none;
    transition: background-color 0.2s;
  }

  .search-result:hover {
    background-color: oklch(from var(--c-surface) l c h / 50%);
  }

  /* The list clips overflow, so keep the ring inside the row. */
  .search-result:focus-visible {
    outline: var(--ring-width) solid var(--ring);
    outline-offset: calc(-1 * var(--ring-width));
  }

  .search-result-heading {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    min-width: 0;
    line-height: var(--lh-sm);
  }

  /* The day as a breadcrumb before the row title. */
  .search-result-date {
    flex-shrink: 0;
    font-size: var(--fs-xs);
    font-variant-numeric: tabular-nums;
    color: var(--c-sub);
  }

  .search-result-date::after {
    content: "/";
    margin-inline-start: var(--space-2);
  }

  .search-result-title {
    overflow: hidden;
    font-weight: var(--fw-medium);
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .search-result-excerpt {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    font-size: var(--fs-xs);
    line-height: var(--lh-sm);
    color: var(--c-sub);
    overflow-wrap: anywhere;
  }

  /* An excerpt that was only the heading collapses to nothing. */
  .search-result-excerpt:empty {
    display: none;
  }

  /* Not `--c-selection`: its dark-mode yellow-9 fill drowns the grey excerpt
     text, so the match gets body colour and weight over a 35% tint instead. */
  .search-result-excerpt :global(mark) {
    padding-inline: 0.125em;
    margin-inline: -0.0625em;
    border-radius: var(--radius-xs);
    background-color: light-dark(
      var(--uchu-yellow-2),
      oklch(from var(--uchu-yellow-9) l c h / 35%)
    );
    color: var(--c-text);
    font-weight: var(--fw-medium);
  }
</style>

<script>
  import {
    isHTMLElement,
    mountSearchDialog,
    renderExcerptParts,
    requireElement,
  } from "@kkhys/search/dialog-setup";
  import { parseExcerpt, stripLeadingText } from "@kkhys/search/excerpt";
  import { toSectionHref } from "@kkhys/search/query";
  import { pickSubResult } from "@kkhys/search/sub-result";
  import type { PagefindSearchFragment } from "@kkhys/search/types";
  import { searchConfig } from "#/features/search/config";
  import { buildSearchOptions, parseSortMode, type SortMode } from "#/features/search/utils/query";
  import { isItemSection } from "#/features/search/utils/section";
  import { formatRunDate } from "#/utils/runs";

  const { metaKeys, sortStorageKey } = searchConfig;

  const readSortMode = (): SortMode => {
    try {
      return parseSortMode(localStorage.getItem(sortStorageKey));
    } catch {
      return parseSortMode(undefined);
    }
  };

  let sortMode = readSortMode();

  const renderResult = (fragment: PagefindSearchFragment, template: HTMLTemplateElement) => {
    const node = template.content.cloneNode(true) as DocumentFragment;
    const date = fragment.meta[metaKeys.date];
    if (import.meta.env.DEV && !date) {
      console.warn(
        "Pagefind fragment is missing the date meta; check data-pagefind-meta in digest-view",
        fragment.url,
        fragment.meta,
      );
    }
    // An item row when one matched; otherwise the heaviest section, which
    // for a hit in the hero is the page itself (no anchor) titled with the
    // h1 headline.
    const section = pickSubResult(fragment, isItemSection);
    const href = section === undefined ? fragment.url : section.url;
    const excerpt = section === undefined ? fragment.excerpt : section.excerpt;
    const title = section?.title ?? fragment.meta["title"] ?? href;

    requireElement(
      node,
      ".search-result",
      (element): element is HTMLAnchorElement => element instanceof HTMLAnchorElement,
    ).href = toSectionHref(href);
    const time = requireElement(
      node,
      ".search-result-date",
      (element): element is HTMLTimeElement => element instanceof HTMLTimeElement,
    );
    // `datetime=""` is not a valid value, so drop the element when the
    // fragment carries no date.
    if (date) {
      time.textContent = formatRunDate(date);
      time.dateTime = date;
    } else {
      time.remove();
    }
    requireElement(node, ".search-result-title", isHTMLElement).textContent = title;
    // The title line already shows the heading the section excerpt opens with.
    renderExcerptParts(
      requireElement(node, ".search-result-excerpt", isHTMLElement),
      stripLeadingText(parseExcerpt(excerpt), title),
    );
    return node;
  };

  const api = mountSearchDialog(searchConfig.dialogId, {
    bundlePath: searchConfig.bundlePath,
    excerptLength: searchConfig.excerptLength,
    maxResults: searchConfig.maxResults,
    debounceMs: searchConfig.debounceMs,
    noun: "記事",
    renderResult,
    searchOptions: () => buildSearchOptions(sortMode),
  });

  const sortToggle = document.querySelector<HTMLElement>(
    `#${searchConfig.dialogId} .search-sort`,
  );
  if (api && sortToggle) {
    const buttons = [...sortToggle.querySelectorAll<HTMLButtonElement>("button[data-sort]")];
    const applySortMode = (mode: SortMode) => {
      sortMode = mode;
      for (const button of buttons) {
        button.setAttribute("aria-pressed", String(button.dataset["sort"] === mode));
      }
    };
    applySortMode(sortMode);

    sortToggle.addEventListener("click", (event) => {
      const button =
        event.target instanceof Element
          ? event.target.closest<HTMLButtonElement>("button[data-sort]")
          : null;
      if (!button) return;
      const mode = parseSortMode(button.dataset["sort"]);
      if (mode === sortMode) return;
      applySortMode(mode);
      try {
        localStorage.setItem(sortStorageKey, mode);
      } catch {
        /* non-persistent session is fine */
      }
      api.input.focus();
      api.runSearch();
    });
  }
</script>
