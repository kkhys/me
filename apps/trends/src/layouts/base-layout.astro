---
import "#/styles/global.css";
import Umami from "@kkhys/analytics/umami.astro";
import BaseSEO from "@kkhys/seo/base-seo.astro";
import OpenGraph from "@kkhys/seo/open-graph.astro";
import TwitterCard from "@kkhys/seo/twitter-card.astro";

interface Props {
  title?: string | undefined;
  description?: string | undefined;
}

const SITE_NAME = "Trend Digest";

const { title = SITE_NAME, description = "Daily tech trend digest by kkhys" } = Astro.props;
---

<html lang="ja">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  {/* Declared before any CSS loads so dark-preference users don't get a
      white canvas flash; pairs with `color-scheme: light dark` in CSS. */}
  <meta name="color-scheme" content="light dark"/>

  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="icon" href="/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">

  <BaseSEO title={title} description={description} />
  <link rel="sitemap" href="/sitemap-index.xml"/>

  <OpenGraph title={title} description={description} siteName={SITE_NAME} />
  <TwitterCard title={title} description={description} site="@kkhys_" card="summary" />

  <Umami websiteId="01beaa78-e50b-4b6a-9288-0d2526a75e12" domains="trends.kkhys.me" />
</head>
<body>
<slot/>
</body>
</html>
