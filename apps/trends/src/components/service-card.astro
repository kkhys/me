---
import type { CollectionEntry } from "astro:content";

import ItemRow from "#/components/item-row.astro";
import SourceCard from "#/components/source-card.astro";
import { itemAnchorId } from "#/utils/highlights";
import { countSeen } from "#/utils/seen";
import { SERVICE_COLORS } from "#/utils/service-colors";

type Service = CollectionEntry<"runs">["data"]["markets"][number]["services"][number];

interface Props {
  service: Service;
  marketId: string;
  highlightedAnchors: ReadonlySet<string>;
}

const { service, marketId, highlightedAnchors } = Astro.props;

const seenCount = countSeen(service.items);
const freshCount = service.items.length - seenCount;
---

<SourceCard
  id={`${marketId}-${service.id}`}
  label={service.label}
  dotColor={SERVICE_COLORS[service.id] ?? "var(--c-sub)"}
  total={service.items.length}
  fresh={seenCount > 0 ? freshCount : undefined}
  note={service.note}
  empty={service.items.length === 0 && service.status === "ok" ? "該当なし" : undefined}
  allSeen={service.items.length > 0 && freshCount === 0}
>
  {
    service.items.map((item, i) => {
      const anchorId = itemAnchorId(marketId, service.id, i + 1);

      return (
        <ItemRow
          item={item}
          rank={i + 1}
          anchorId={anchorId}
          highlighted={highlightedAnchors.has(anchorId)}
        />
      );
    })
  }
</SourceCard>
