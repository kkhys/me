---
import type { CollectionEntry } from "astro:content";

import ItemRow from "#/components/item-row.astro";
import { countSeen } from "#/utils/seen";
import { SERVICE_COLORS } from "#/utils/service-colors";

type Service = CollectionEntry<"runs">["data"]["markets"][number]["services"][number];

interface Props {
  service: Service;
  marketId: string;
}

const { service, marketId } = Astro.props;

const dotColor = SERVICE_COLORS[service.id] ?? "var(--c-sub)";
const seenCount = countSeen(service.items);
const freshCount = service.items.length - seenCount;
---

<section class:list={["service", { "has-seen": seenCount > 0 }]} data-service={service.id}>
  <header>
    <span class="dot" style={`background:${dotColor}`}></span>
    <h3 id={`${marketId}-${service.id}`}>{service.label}</h3>
    <span class="count total">{service.items.length}件</span>
    {seenCount > 0 && <span class="count fresh">{freshCount}件</span>}
    {service.note && <span class="note">{service.note}</span>}
  </header>
  {service.items.map((item, i) => <ItemRow item={item} rank={i + 1} />)}
  {service.items.length === 0 && service.status === "ok" && <p class="empty">該当なし</p>}
  {service.items.length > 0 && freshCount === 0 && <p class="empty all-seen">すべて既出</p>}
</section>

<style>
  .service {
    margin-bottom: 2.5rem;
  }

  header {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    padding-bottom: 0.625rem;
    border-bottom: 1px solid var(--c-border);
  }

  .dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    align-self: center;
    flex: none;
  }

  h3 {
    margin: 0;
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    /* Breathing room above anchor-jump targets. */
    scroll-margin-top: 1.25rem;
  }

  .count {
    color: var(--c-sub);
    font-size: var(--fs-xs);
  }

  /* Both counts are prerendered; the 既出 filter swaps them with CSS only. */
  .count.fresh {
    display: none;
  }

  :global(html[data-seen-filter="hide"]) .service.has-seen .count.total {
    display: none;
  }

  :global(html[data-seen-filter="hide"]) .service.has-seen .count.fresh {
    display: inline;
  }

  .note {
    color: var(--c-sub);
    font-size: var(--fs-xs);
    margin-left: auto;
    text-align: right;
  }

  .empty {
    margin: 0;
    padding: 0.625rem var(--space-1);
    color: var(--c-sub);
    font-size: var(--fs-xs);
    border-bottom: 1px solid var(--c-border);
  }

  /* Keeps a fully-filtered service from collapsing to a bare header. */
  .all-seen {
    display: none;
  }

  :global(html[data-seen-filter="hide"]) .all-seen {
    display: block;
  }
</style>
