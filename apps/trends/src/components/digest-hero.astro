---
import type { CollectionEntry } from "astro:content";

interface Props {
  digest: CollectionEntry<"runs">["data"]["digest"];
}

const { digest } = Astro.props;
---

<section class="hero">
  <h1 class="headline palt">{digest.headline}</h1>
  <p class="lead">{digest.lead}</p>
  <ol class="highlights">
    {
      digest.highlights.map((highlight) => (
        <li>
          <span class="hl-title">
            <a href={highlight.url} target="_blank" rel="noopener">
              {highlight.title}
            </a>
            <span class="hl-service">{highlight.service_label}</span>
          </span>
          <span class="hl-reason">{highlight.reason}</span>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .hero {
    margin-top: 2rem;
  }

  .headline {
    margin: 0;
    font-size: var(--fs-lg);
    font-weight: var(--fw-medium);
    line-height: 1.5;
  }

  .lead {
    margin: 0.75rem 0 1.5rem;
    color: var(--c-sub);
    font-size: var(--fs-sm);
  }

  .highlights {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: hl;
    border-top: 1px solid var(--c-border);
  }

  .highlights li {
    counter-increment: hl;
    margin: 0;
    padding: 0.75rem 0.25rem;
    border-bottom: 1px solid var(--c-border);
  }

  .highlights li::before {
    content: counter(hl, decimal-leading-zero);
    color: var(--c-sub);
    font-size: var(--fs-xs);
    font-variant-numeric: tabular-nums;
    margin-right: 0.75rem;
  }

  .hl-title {
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
  }

  .hl-service {
    font-size: var(--fs-2xs);
    font-weight: var(--fw-normal);
    color: var(--c-sub);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-full);
    padding: 0.0625rem 0.5rem;
    margin-left: 0.5rem;
    white-space: nowrap;
  }

  .hl-reason {
    display: block;
    margin: 0.25rem 0 0 1.9rem;
    font-size: var(--fs-xs);
    color: var(--c-sub);
  }
</style>
