---
import type { CollectionEntry } from "astro:content";

import Budoux from "#/components/budoux.astro";

interface Props {
  digest: CollectionEntry<"runs">["data"]["digest"];
}

const { digest } = Astro.props;
---

<section class="hero">
  <Budoux>
    <h1 class="headline palt">{digest.headline}</h1>
  </Budoux>
  <Budoux>
    <p class="lead">{digest.lead}</p>
  </Budoux>
  <ol class="highlights">
    {
      digest.highlights.map((highlight, i) => (
        <li>
          <span class="hl-rank">{i + 1}</span>
          <div class="hl-body">
            <Budoux>
              <span class="hl-title palt">
                <a href={highlight.url} target="_blank" rel="noopener">
                  {highlight.title_ja || highlight.title}
                </a>
                <span class="hl-service">{highlight.service_label}</span>
              </span>
            </Budoux>
            {highlight.title_ja && <span class="hl-original">{highlight.title}</span>}
            <Budoux>
              <span class="hl-reason">{highlight.reason}</span>
            </Budoux>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .hero {
    margin-top: 2.25rem;
  }

  .headline {
    margin: 0;
    /* Same size as the market h2 headings — the hero should not shout. */
    font-size: 1rem;
    font-weight: var(--fw-medium);
    line-height: 1.6;
  }

  .lead {
    margin: 0.875rem 0 1.5rem;
    color: var(--c-sub);
    font-size: var(--fs-sm);
    line-height: 1.7;
  }

  .highlights {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .highlights li {
    display: flex;
    gap: 0.75rem;
    margin: 0;
    padding: 0.875rem 0.25rem;
    border-top: 1px solid var(--c-border);
  }

  .highlights li:last-child {
    border-bottom: 1px solid var(--c-border);
  }

  .hl-rank {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.375rem;
    height: 1.375rem;
    margin-top: 0.1rem;
    border-radius: var(--radius-full);
    background: var(--c-primary);
    color: var(--c-primary-text);
    font-size: var(--fs-2xs);
    font-weight: var(--fw-medium);
    font-variant-numeric: tabular-nums;
  }

  .hl-body {
    min-width: 0;
  }

  .hl-title {
    font-size: 0.9375rem;
    font-weight: var(--fw-medium);
    line-height: 1.6;
  }

  .hl-service {
    font-size: var(--fs-2xs);
    font-weight: var(--fw-normal);
    color: var(--c-sub);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-full);
    padding: 0.0625rem 0.5rem;
    margin-left: 0.5rem;
    white-space: nowrap;
  }

  .hl-original {
    display: block;
    margin-top: 0.15rem;
    color: var(--c-faint);
    font-size: var(--fs-xs);
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .hl-reason {
    display: block;
    margin-top: 0.25rem;
    font-size: var(--fs-xs);
    color: var(--c-sub);
    line-height: 1.6;
  }
</style>
