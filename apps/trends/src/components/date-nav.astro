---
import { formatRunDate } from "#/utils/runs";

interface Props {
  current: string;
  prev: string | undefined;
  next: string | undefined;
}

const { current, prev, next } = Astro.props;
---

<nav class="date-nav" aria-label="日付ナビゲーション">
  <span class="slot">{prev && <a href={`/${prev}`}>← 前日</a>}</span>
  <a class="current" href="/archive" title="アーカイブを開く">{formatRunDate(current)}</a>
  <span class="slot end">{next && <a href={`/${next}`}>翌日 →</a>}</span>
</nav>

<style>
  .date-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.5rem;
    font-size: var(--fs-xs);
    color: var(--c-sub);
  }

  a {
    color: var(--c-sub);
  }

  a:hover {
    color: var(--c-text);
  }

  .current {
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    font-variant-numeric: tabular-nums;
    color: var(--c-text);
  }

  .slot {
    flex: 1;
  }

  .slot.end {
    text-align: right;
  }
</style>
