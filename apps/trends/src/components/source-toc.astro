---
import type { CollectionEntry } from "astro:content";

import { SERVICE_COLORS } from "#/utils/service-colors";

type Market = CollectionEntry<"runs">["data"]["markets"][number];

interface Props {
  markets: Market[];
}

const { markets } = Astro.props;

interface TocEntry {
  depth: 2 | 3;
  id: string;
  label: string;
  color: string | undefined;
}

const entries: TocEntry[] = [];

for (const market of markets) {
  entries.push({ depth: 2, id: market.id, label: market.label, color: undefined });

  for (const service of market.services) {
    entries.push({
      depth: 3,
      id: `${market.id}-${service.id}`,
      label: service.label,
      color: SERVICE_COLORS[service.id] ?? "var(--c-sub)",
    });
  }
}
---

{entries.length > 0 && (
  <nav class="toc" aria-label="ソース一覧">
    <ul class="toc-list">
      {entries.map((entry) => (
        <li class:list={["toc-item", `toc-item--depth-${entry.depth}`]}>
          <a href={`#${entry.id}`} class="toc-link">
            {entry.color && <span class="toc-dot" style={`background:${entry.color}`} />}
            <span class="toc-link-text palt">{entry.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  /* Always-visible outline; no card box, matching the site's hairline design
     language. Hidden below the width where it would collide with the 42rem
     content column. */
  .toc {
    display: none;
  }

  @media (width >= 1280px) {
    .toc {
      display: block;
      width: max-content;
      max-width: 14rem;
      max-height: calc(100dvh - 15rem);
      overflow-y: auto;
      overscroll-behavior: contain;
    }

    .toc::-webkit-scrollbar {
      width: 3px;
    }

    .toc::-webkit-scrollbar-thumb {
      background: var(--c-sub);
      border-radius: 2px;
    }

    @supports (-moz-appearance: none) {
      .toc {
        scrollbar-width: thin;
      }
    }
  }

  .toc-list {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .toc-item {
    margin: 0;
    padding: 0;
  }

  .toc-item--depth-2:not(:first-child) {
    margin-top: 0.75rem;
  }

  .toc-item--depth-2 .toc-link {
    font-weight: var(--fw-medium);
  }

  .toc-item--depth-3 .toc-link {
    margin-inline-start: 12px;
  }

  .toc-link {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px;
    font-size: 13px;
    line-height: 1.3;
    color: var(--c-sub);
    text-decoration: none;
    transition: color 0.15s;
  }

  .toc-link:hover {
    color: var(--c-text);
  }

  .toc-link.toc-link--active {
    color: light-dark(var(--uchu-blue-5), var(--uchu-blue-3));
  }

  .toc-dot {
    width: 0.3rem;
    height: 0.3rem;
    border-radius: 50%;
    flex: none;
  }

  .toc-link-text {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
    overflow: hidden;
  }
</style>

<script>
  import { pickActiveId } from "#/utils/toc-active";

  const ACTIVE_CLASS = "toc-link--active";

  const toc = document.querySelector(".toc");
  if (toc) {
    const links = [...toc.querySelectorAll<HTMLAnchorElement>(".toc-link")];
    const linkById = new Map(links.map((link) => [decodeURIComponent(link.hash.slice(1)), link]));
    const headings = [...document.querySelectorAll<HTMLElement>("main :is(h2, h3)[id]")].filter(
      (heading) => linkById.has(heading.id),
    );
    const orderedIds = headings.map((heading) => heading.id);
    const visibleIds = new Set<string>();
    let activeId: string | null = null;

    const setActive = (id: string | null) => {
      if (id === activeId) return;
      activeId = id;
      const activeLink = id ? linkById.get(id) : undefined;
      for (const link of links) {
        link.classList.toggle(ACTIVE_CLASS, link === activeLink);
      }
      activeLink?.scrollIntoView({ block: "nearest" });
    };

    // Animate the jump, honoring reduced-motion preferences.
    const headingById = new Map(headings.map((heading) => [heading.id, heading]));
    for (const link of links) {
      link.addEventListener("click", (event) => {
        const heading = headingById.get(decodeURIComponent(link.hash.slice(1)));
        if (!heading) return;
        event.preventDefault();
        const behavior = matchMedia("(prefers-reduced-motion: reduce)").matches
          ? "auto"
          : "smooth";
        heading.scrollIntoView({ behavior });
        history.pushState(null, "", link.hash);
      });
    }

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) visibleIds.add(entry.target.id);
          else visibleIds.delete(entry.target.id);
        }
        setActive(pickActiveId(orderedIds, visibleIds, activeId));
      },
      // Treat the top 20% of the viewport as the "current section" band.
      { rootMargin: "0px 0px -80% 0px" },
    );

    for (const heading of headings) observer.observe(heading);
  }
</script>
