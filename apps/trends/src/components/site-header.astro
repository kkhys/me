---
interface Props {
  date?: string | undefined;
  markets?: { id: string; label: string }[] | undefined;
}

const { date, markets } = Astro.props;

const tabs = markets ? [{ id: "all", label: "すべて" }, ...markets] : undefined;
---

<header class="site">
  <div class="site-inner">
    <span class="brand">
      <a href="/">Trend Digest</a>
      {date && <span class="date">{date}</span>}
    </span>
    {
      tabs && (
        <nav class="tabs" aria-label="市場フィルタ">
          <ul id="tabs">
            {tabs.map((tab, i) => (
              <li class={i === 0 ? "active" : undefined}>
                <button type="button" data-tab={tab.id} aria-pressed={i === 0}>
                  {tab.label}
                </button>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
    {
      tabs && (
        <div class="filter">
          <input
            type="search"
            id="filter"
            placeholder="キーワードで絞り込み"
            aria-label="キーワードで絞り込み"
          />
        </div>
      )
    }
  </div>
</header>

<script>
  const tabList = document.querySelector("#tabs");

  tabList?.addEventListener("click", (e) => {
    const btn =
      e.target instanceof Element ? e.target.closest<HTMLButtonElement>("button[data-tab]") : null;

    if (!btn) {
      return;
    }

    for (const li of tabList.querySelectorAll("li")) {
      const active = li.contains(btn);
      li.classList.toggle("active", active);
      li.querySelector("button")?.setAttribute("aria-pressed", String(active));
    }

    const id = btn.dataset.tab;

    for (const market of document.querySelectorAll<HTMLElement>(".market")) {
      market.classList.toggle("hidden", id !== "all" && market.dataset.market !== id);
    }
  });

  const filter = document.querySelector("#filter");

  if (filter instanceof HTMLInputElement) {
    filter.addEventListener("input", () => {
      const q = filter.value.trim().toLowerCase();

      for (const service of document.querySelectorAll<HTMLElement>(".service")) {
        let visible = 0;

        for (const item of service.querySelectorAll<HTMLElement>(".item[data-text]")) {
          const hit = q === "" || (item.dataset.text ?? "").includes(q);
          item.classList.toggle("hidden", !hit);

          if (hit) {
            visible += 1;
          }
        }

        const count = service.querySelector("[data-count]");

        if (count) {
          count.textContent = `${visible}件`;
        }

        service.classList.toggle("hidden", q !== "" && visible === 0);
      }
    });
  }
</script>

<style>
  header.site {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--c-bg) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--c-border);
  }

  .site-inner {
    max-width: 980px;
    margin: 0 auto;
    padding: 10px 20px;
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .brand {
    font-weight: 700;
    font-size: 17px;
  }

  .brand a {
    color: var(--c-text);
  }

  .brand .date {
    color: var(--c-muted);
    font-weight: 400;
    font-size: 13px;
    margin-left: 8px;
  }

  nav.tabs ul {
    list-style: none;
    display: flex;
    gap: 4px;
    margin: 0;
    padding: 0;
    position: relative;
  }

  nav.tabs button {
    border: 0;
    background: none;
    color: var(--c-muted);
    font: inherit;
    font-size: 14px;
    padding: 6px 12px;
    cursor: pointer;
    border-radius: 6px;
  }

  nav.tabs li.active button {
    color: var(--c-text);
    font-weight: 600;
  }

  nav.tabs li.active {
    anchor-name: --active-tab;
  }

  nav.tabs ul::before {
    content: "";
    position: absolute;
    position-anchor: --active-tab;
    inset-block-start: calc(anchor(bottom) - 2px);
    inset-inline-start: anchor(left);
    inset-inline-end: anchor(right);
    block-size: 2px;
    background: var(--c-accent);
    border-radius: 2px;
  }

  @media (prefers-reduced-motion: no-preference) {
    nav.tabs ul::before {
      transition: inset 0.2s;
    }
  }

  @supports not (position-anchor: --a) {
    nav.tabs ul::before {
      content: none;
    }

    nav.tabs li.active button {
      box-shadow: inset 0 -2px 0 var(--c-accent);
      border-radius: 6px 6px 0 0;
    }
  }

  .filter {
    margin-left: auto;
  }

  .filter input {
    background: var(--c-card);
    color: var(--c-text);
    border: 1px solid var(--c-border);
    border-radius: 8px;
    padding: 6px 12px;
    font: inherit;
    font-size: 13px;
    width: 190px;
  }

  .filter input:focus {
    outline: 2px solid var(--c-accent);
    outline-offset: -1px;
  }
</style>
