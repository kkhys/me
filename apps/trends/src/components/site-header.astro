---
const path = Astro.url.pathname.replace(/\/$/u, "") || "/";
const links = [
  { href: "/archive", label: "Archive" },
  { href: "/about", label: "About" },
];
---

<header>
  <div class="site-inner">
    <span class="brand">
      <a href="/">Trend Digest</a>
    </span>
    <nav class="menu" aria-label="サイト内リンク">
      {
        links.map(({ href, label }) => (
          <a href={href} aria-current={path === href ? "page" : undefined}>
            {label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .site-inner {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 0.625rem var(--space-4);
    display: flex;
    align-items: center;
  }

  /* Keep the brand aligned with the content column edge (see digest-view). */
  @media (width >= 640px) {
    .site-inner {
      padding-inline: 0;
    }
  }

  .brand {
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
  }

  .menu {
    margin-left: auto;
    display: flex;
    gap: var(--space-4);
    font-size: var(--fs-xs);
  }

  .menu a {
    color: var(--c-sub);
  }

  .menu a:hover,
  .menu a[aria-current="page"] {
    color: var(--c-text);
  }

  .menu a[aria-current="page"] {
    font-weight: var(--fw-medium);
  }
</style>
