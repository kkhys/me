---
import type { CollectionEntry } from "astro:content";

import { scoreLevel } from "#/utils/score";
import { buildSearchText } from "#/utils/search";

type Item =
  CollectionEntry<"runs">["data"]["markets"][number]["services"][number]["items"][number];

interface Props {
  item: Item;
  rank: number;
}

const { item, rank } = Astro.props;

const hasDiscussionLink = item.comments_url !== "" && item.comments_url !== item.url;
---

<article class="item" data-text={buildSearchText(item)}>
  <span class="rank">{rank}</span>
  <span class:list={["score", scoreLevel(item.score)]}>{item.score}</span>
  <div class="body">
    <div class="title palt">
      <a href={item.url} target="_blank" rel="noopener">{item.title}</a>
    </div>
    <div class="meta">
      <span class="stars" title="興味マッチ度">{"★".repeat(item.interest)}</span>
      {item.category && <span class="chip">{item.category}</span>}
      {item.engagement_label && <span>{item.engagement_label}</span>}
      {item.seen_before && <span class="seen">既出</span>}
      {
        hasDiscussionLink && (
          <a class="comments" href={item.comments_url} target="_blank" rel="noopener">
            議論を見る
          </a>
        )
      }
    </div>
    {item.summary && <div class="summary">{item.summary}</div>}
  </div>
</article>

<style>
  .item {
    display: flex;
    gap: 0.75rem;
    padding: 0.625rem 0.25rem;
    border-bottom: 1px solid var(--c-border);
  }

  .rank {
    flex: none;
    width: 1.1rem;
    text-align: right;
    color: var(--c-sub);
    font-size: var(--fs-xs);
    font-variant-numeric: tabular-nums;
    padding-top: 0.15rem;
  }

  .score {
    flex: none;
    width: 2rem;
    text-align: right;
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    font-variant-numeric: tabular-nums;
  }

  .score.hi {
    color: var(--c-text);
  }

  .score.mid {
    color: var(--c-sub);
  }

  .score.lo {
    color: var(--c-faint);
  }

  .body {
    min-width: 0;
  }

  .title {
    font-size: var(--fs-sm);
    line-height: 1.5;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    align-items: center;
    color: var(--c-sub);
    font-size: var(--fs-xs);
    margin-top: 0.2rem;
  }

  .stars {
    color: var(--c-star);
    letter-spacing: 1px;
  }

  .chip {
    border: 1px solid var(--c-border);
    border-radius: var(--radius-full);
    padding: 0 0.5rem;
    font-size: var(--fs-2xs);
    line-height: 1.1rem;
  }

  .seen {
    border: 1px solid var(--c-border);
    border-radius: var(--radius-sm);
    padding: 0 0.3rem;
    font-size: var(--fs-2xs);
  }

  .comments {
    text-decoration: underline;
    text-underline-offset: 2px;
    white-space: nowrap;
  }

  .summary {
    color: var(--c-sub);
    font-size: var(--fs-xs);
    margin-top: 0.2rem;
  }
</style>
