---
import type { CollectionEntry } from "astro:content";

import DateNav from "#/components/date-nav.astro";
import DigestHero from "#/components/digest-hero.astro";
import MarketSection from "#/components/market-section.astro";

interface Props {
  entry: CollectionEntry<"runs">;
  prev: string | undefined;
  next: string | undefined;
}

const { entry, prev, next } = Astro.props;
const { digest, markets, generated_at } = entry.data;
---

<div class="wrap">
  <DateNav prev={prev} next={next} />
  <DigestHero digest={digest} />
  <main>
    {markets.map((market) => <MarketSection market={market} />)}
  </main>
  <footer class="site">生成: {generated_at}</footer>
</div>

<style>
  .wrap {
    max-width: 980px;
    margin: 0 auto;
    padding: 0 20px 60px;
  }

  footer.site {
    margin-top: 44px;
    color: var(--c-muted);
    font-size: 12.5px;
    border-top: 1px solid var(--c-border);
    padding-top: 14px;
  }
</style>
