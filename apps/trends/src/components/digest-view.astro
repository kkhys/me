---
import type { CollectionEntry } from "astro:content";

import DateNav from "#/components/date-nav.astro";
import DigestHero from "#/components/digest-hero.astro";
import DigestToolbar from "#/components/digest-toolbar.astro";
import GroupSection from "#/components/group-section.astro";
import ServiceCard from "#/components/service-card.astro";
import SourceToc from "#/components/source-toc.astro";
import UpdatesSection from "#/components/updates-section.astro";
import { highlightAnchors } from "#/utils/highlights";
import { sortMarketsGlobalFirst } from "#/utils/markets";
import { formatGeneratedAt } from "#/utils/runs";
import { countSeen } from "#/utils/seen";
import { UPDATES_ID } from "#/utils/updates";

interface Props {
  entry: CollectionEntry<"runs">;
  prev: string | undefined;
  next: string | undefined;
}

const { entry, prev, next } = Astro.props;
const { date, digest, generated_at, updates } = entry.data;
const markets = sortMarketsGlobalFirst(entry.data.markets);
const itemTotal =
  updates.reduce((n, product) => n + product.items.length, 0) +
  markets.reduce(
    (total, market) => total + market.services.reduce((n, s) => n + s.items.length, 0),
    0,
  );
const seenTotal = markets.reduce(
  (total, market) => total + market.services.reduce((n, s) => n + countSeen(s.items), 0),
  0,
);
/* The updates group resolves like a market, so a highlight can jump to a
   release-note row too. */
const anchors = highlightAnchors(
  [{ id: UPDATES_ID, services: updates }, ...markets],
  digest.highlights,
);
const highlightedAnchors = new Set(anchors.values());
---

<aside class="sidebar">
  <SourceToc updates={updates} markets={markets} />
</aside>
<div class="wrap">
  <DateNav current={date} prev={prev} next={next} />
  <main id="main">
    <DigestHero digest={digest} anchors={anchors} />
    <DigestToolbar date={date} total={itemTotal} seen={seenTotal} />
    <UpdatesSection updates={updates} highlightedAnchors={highlightedAnchors} />
    {
      markets.map((market) => (
        <GroupSection id={market.id} label={market.label}>
          {market.services.map((service) => (
            <ServiceCard
              service={service}
              marketId={market.id}
              highlightedAnchors={highlightedAnchors}
            />
          ))}
        </GroupSection>
      ))
    }
  </main>
  <DateNav current={date} prev={prev} next={next} position="bottom" />
  <footer class="site">生成: {formatGeneratedAt(generated_at)}</footer>
</div>

<style>
  @media (width >= 1280px) {
    /* Same placement as apps/me's blog-layout sidebar: top-anchored, inset
       2rem from the right edge. */
    .sidebar {
      position: fixed;
      top: 13rem;
      right: 2rem;
      width: fit-content;
    }
  }

  .wrap {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 0 var(--space-4) 3.5rem;
  }

  /* Same rhythm as apps/me: below 640px the column keeps 1rem side padding,
     above it the full 42rem is used. */
  @media (width >= 640px) {
    .wrap {
      padding-inline: 0;
    }
  }

  footer.site {
    margin-top: var(--space-6);
    padding-top: 0.875rem;
    border-top: 1px solid var(--c-border);
    color: var(--c-sub);
    font-size: var(--fs-xs);
    font-variant-numeric: tabular-nums;
  }
</style>
