---
import { getImage } from "astro:assets";
import { type CollectionEntry, getCollection } from "astro:content";
import ArrowLeftIcon from "@kkhys/ui/icons/arrow-left.svg";
import CheckIcon from "@kkhys/ui/icons/check.svg";
import { formatForEntry } from "#/components/lgtm-image";
import BaseSeo from "#/components/seo/base-seo.astro";
import JsonLd from "@kkhys/seo/json-ld.astro";
import OpenGraph from "#/components/seo/open-graph.astro";
import TwitterCard from "#/components/seo/twitter-card.astro";
import { TITLE } from "#/config/constants";
import Layout from "#/layouts/layout.astro";
import { lgtmAlt } from "#/utils/alt";

export const getStaticPaths = async () => {
  const lgtmEntries = await getCollection("lgtm");
  return lgtmEntries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
};

type Props = {
  entry: CollectionEntry<"lgtm">;
};

const { entry } = Astro.props;
const id = entry.id;

const format = formatForEntry(entry);

const blurryImage = await getImage({
  src: `/${id}-400.${format}`,
  width: 20,
  height: 13,
  format: "webp",
});

const title = `LGTM Image - ${TITLE}`;
const description = "Perfect LGTM image for your GitHub Pull Request reviews.";
const ogImageUrl = new URL(`/api/og/${id}.png`, Astro.site).href;
---

<Layout heading>
  <BaseSeo slot="seo" title={title} description={description} />
  <OpenGraph
    slot="seo"
    title={title}
    description={description}
    image={ogImageUrl}
    imageAlt={lgtmAlt(entry.data.description)}
    type="article"
  />
  <TwitterCard
    slot="seo"
    title={title}
    description={description}
    image={ogImageUrl}
    imageAlt={lgtmAlt(entry.data.description)}
  />
  <JsonLd
    slot="structured-data"
    type="Article"
    data={{
      headline: title,
      description: description,
      inLanguage: "en-US",
    }}
  />

  <div class="container">
    <div class="detail-wrapper">
      <div class="image-container">
        <div
          class="blur-load"
          style={`background: url(${blurryImage.src}) center / cover no-repeat;`}
        >
          <img
            src={`/${id}-1200.${format}`}
            alt={lgtmAlt(entry.data.description)}
            width={1200}
            height={800}
            loading="eager"
            decoding="async"
            class="detail-image"
            onload="this.closest('.blur-load')?.classList.add('image-loaded')"
          />
        </div>
      </div>

      <div class="info-bar">
        {/* Announces the clipboard result; the button itself only swaps its icon. */}
        <p class="sr-only" role="status" id="copy-status"></p>
        <div class="actions">
          <button
            class="copy-format-button"
            data-id={id}
            data-format={format}
          >
            <span class="button-text">Copy embed code</span>
            <CheckIcon class="check-icon" width={18} height={18} />
          </button>

          <a
            href="/"
            class="icon-button"
            title="Back to gallery"
            aria-label="Back to gallery"
          >
            <ArrowLeftIcon width={18} height={18} />
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-8) var(--space-4);
    width: 100%;
    box-sizing: border-box;
  }

  .detail-wrapper {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .image-container {
    width: 100%;
    border-radius: 1rem;
    overflow: hidden;
    background-color: var(--c-surface);
  }

  .blur-load {
    width: 100%;
    position: relative;
    filter: blur(36px);
    transition: filter 250ms ease-in-out;
  }

  .blur-load.image-loaded {
    background: none;
    filter: blur(0);
  }

  .detail-image {
    width: 100%;
    height: auto;
    display: block;
  }

  .info-bar {
    padding: var(--space-2) 0;
  }

  .actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .copy-format-button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-1) var(--space-2);
    font-size: 0.75rem;
    font-family: var(--font-mono);
    border: 1px solid var(--c-border);
    border-radius: 0.25rem;
    background-color: transparent;
    color: var(--c-sub);
    cursor: pointer;
    transition: all 0.1s ease;
  }

  .copy-format-button:hover {
    border-color: var(--c-sub);
    background-color: var(--c-bg-gray);
    color: var(--c-text);
  }

  .copy-format-button:active {
    transform: scale(0.95);
  }

  .copy-format-button.copied {
    border-color: var(--c-text-emphasis);
  }

  .copy-format-button .button-text {
    transition: opacity 0.1s ease;
  }

  .copy-format-button.copied .button-text {
    opacity: 0;
  }

  .copy-format-button .check-icon {
    position: absolute;
    width: 0.875rem;
    height: 0.875rem;
    opacity: 0;
    transition: opacity 0.1s ease;
  }

  .copy-format-button.copied .check-icon {
    opacity: 1;
  }

  .icon-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.25rem;
    color: var(--c-text-emphasis);
    transition: all 0.1s ease;
    text-decoration: none;
    border: none;
    background-color: transparent;
    cursor: pointer;
  }

  .icon-button:hover {
    background-color: var(--c-bg-gray);
    color: var(--c-text);
  }

  .icon-button:active {
    transform: scale(0.9);
  }

  @media (max-width: 768px) {
    .container {
      padding: var(--space-4);
    }

    .detail-wrapper {
      gap: var(--space-3);
    }

    .image-container {
      border-radius: 0.75rem;
    }

    .info-bar {
      padding: var(--space-1) 0;
    }

    .actions {
      gap: var(--space-2);
    }

    .copy-format-button {
      flex: 1;
    }
  }

  @media (max-width: 480px) {
    .container {
      padding: var(--space-3);
    }

    .detail-wrapper {
      gap: var(--space-2);
    }

    .image-container {
      border-radius: 0.5rem;
    }

    .actions {
      gap: var(--space-2);
    }

    .copy-format-button {
      font-size: 0.6875rem;
      padding: var(--space-1) 0.375rem;
    }

    .icon-button {
      width: 1.75rem;
      height: 1.75rem;
    }

    .icon-button svg {
      width: 16px;
      height: 16px;
    }
  }
</style>

<script>
  import { buildEmbedCode } from "#/utils/embed";

  document.addEventListener("DOMContentLoaded", () => {
    const copyButtons = document.querySelectorAll(".copy-format-button");
    const status = document.querySelector("#copy-status");

    copyButtons.forEach((button) => {
      button.addEventListener("click", async () => {
        const id = (button as HTMLElement).dataset.id;
        const format = (button as HTMLElement).dataset.format;
        if (!id || !format) return;

        try {
          await navigator.clipboard.writeText(buildEmbedCode(id, format));
          button.classList.add("copied");
          if (status) status.textContent = "Copied";
          setTimeout(() => {
            button.classList.remove("copied");
            if (status) status.textContent = "";
          }, 1000);
        } catch (err) {
          console.error("Failed to copy:", err);
        }
      });
    });
  });
</script>
