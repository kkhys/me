---
import Umami from "@kkhys/analytics/umami.astro";
import BlurLoadNoscript from "@kkhys/ui/blur-load-noscript.astro";
import SiteFooter from "@kkhys/ui/site-footer.astro";
import SiteHeader from "@kkhys/ui/site-header.astro";
import HeadMeta from "#/components/seo/head-meta.astro";
import "#/styles/global.css";

const FOOTER_LINKS = [
  { href: "/privacy", label: "Privacy Policy" },
  { href: "/copyright", label: "Copyright" },
];
---

<html lang="en">
    <head>
        <HeadMeta />
        {/* Declared before any CSS loads so dark-preference users don't get a
            white canvas flash; pairs with `color-scheme: light dark` in CSS. */}
        <meta name="color-scheme" content="light dark" />
        <Umami websiteId="115514e5-6612-4721-8913-1d0d904fd333" domains="lgtm.kkhys.me" />
        <slot name="head" />
        <slot name="seo" />
        <slot name="structured-data" />
        <BlurLoadNoscript />
    </head>
    <body>
        <SiteHeader title="LGTM" href="/" />
        <main>
            <slot />
        </main>
        <SiteFooter author="Keisuke Hayashi" authorUrl="https://kkhys.me" links={FOOTER_LINKS} />
    </body>
</html>
