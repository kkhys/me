---
import Umami from "@kkhys/analytics/umami.astro";
import BlurLoadNoscript from "@kkhys/ui/blur-load-noscript.astro";
import SiteFooter from "@kkhys/ui/site-footer.astro";
import SiteHeader from "@kkhys/ui/site-header.astro";
import HeadMeta from "@kkhys/ui/head-meta.astro";
import SkipLink from "@kkhys/ui/skip-link.astro";
import "#/styles/global.css";

interface Props {
  /** Document language; the legal pages have Japanese versions. */
  lang?: "en" | "ja" | undefined;
  /** Renders the header title as the h1 (pages without a heading of their own). */
  heading?: boolean | undefined;
}

const { lang = "en", heading = false } = Astro.props;

const FOOTER_LINKS = [
  { href: "/privacy", label: "Privacy Policy" },
  { href: "/copyright", label: "Copyright" },
];
---

<html lang={lang}>
    <head>
        <HeadMeta />
        <Umami websiteId="115514e5-6612-4721-8913-1d0d904fd333" domains="lgtm.kkhys.me" />
        <slot name="head" />
        <slot name="seo" />
        <slot name="structured-data" />
        <BlurLoadNoscript />
    </head>
    <body>
        <SkipLink label="Skip to content" />
        <SiteHeader title="LGTM" href="/" heading={heading} />
        <main id="main">
            <slot />
        </main>
        <SiteFooter author="Keisuke Hayashi" authorUrl="https://kkhys.me" links={FOOTER_LINKS} />
    </body>
</html>
