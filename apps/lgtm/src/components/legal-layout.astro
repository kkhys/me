---
interface Props {
  currentLang: "en" | "ja";
  currentPage: "privacy" | "copyright";
}

const { currentLang, currentPage } = Astro.props;
---

<article>
	<div class="language-toggle">
		{currentLang === "en" ? (
			<>
				<span class="current">English</span>
				<a href={`/${currentPage}/ja`}>日本語</a>
			</>
		) : (
			<>
				<a href={`/${currentPage}`}>English</a>
				<span class="current">日本語</span>
			</>
		)}
	</div>

	<slot />
</article>

<style>
	article {
		max-width: 800px;
		margin: 0 auto;
		padding: var(--space-8) var(--space-4);
		line-height: 1.8;
	}

	.language-toggle {
		display: flex;
		gap: var(--space-4);
		margin-bottom: var(--space-8);
		font-size: var(--fs-sm);
	}

	.language-toggle a {
		color: var(--c-sub);
		text-decoration: underline;
		transition: color 0.2s;
	}

	.language-toggle a:hover {
		color: var(--c-text);
	}

	.language-toggle .current {
		color: var(--c-text);
		font-weight: var(--fw-medium);
	}

	article :global(h1) {
		font-size: var(--fs-xl);
		margin-bottom: var(--space-8);
		color: var(--c-text-emphasis);
	}

	article :global(h2) {
		font-size: var(--fs-lg);
		margin-top: var(--space-8);
		margin-bottom: var(--space-4);
		color: var(--c-text-emphasis);
	}

	article :global(h3) {
		font-size: var(--fs-md);
		margin-top: var(--space-6);
		margin-bottom: var(--space-3);
	}

	article :global(p) {
		margin-bottom: var(--space-4);
	}

	article :global(ul) {
		margin-bottom: var(--space-4);
		padding-left: var(--space-6);
		list-style-type: disc;
	}

	article :global(li) {
		margin-bottom: var(--space-2);
		padding-left: var(--space-1);
	}

	article :global(a) {
		color: var(--c-text-emphasis);
		text-decoration: underline;
	}

	article :global(a:hover) {
		opacity: 0.7;
	}

	article :global(.last-updated) {
		margin-top: var(--space-12);
		font-size: var(--fs-sm);
		font-variant-numeric: tabular-nums;
		color: var(--c-sub);
		text-align: right;
	}
</style>
