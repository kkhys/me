---
import "#/styles/global.css";
import Umami from "@kkhys/analytics/umami.astro";
import BlurLoadNoscript from "@kkhys/ui/blur-load-noscript.astro";
import HeadMeta from "@kkhys/ui/head-meta.astro";
import BaseSEO from "@kkhys/seo/base-seo.astro";
import OpenGraph from "@kkhys/seo/open-graph.astro";
import TwitterCard from "@kkhys/seo/twitter-card.astro";

interface Props {
  title?: string | undefined;
  description?: string | undefined;
  image?: { src: string; width: number; height: number } | undefined;
}

const SITE_NAME = "Keisuke Hayashi Diary";

const {
  title = SITE_NAME,
  description = "Photo diary by kkhys",
  image,
} = Astro.props;

const ogImageUrl = image ? new URL(image.src, Astro.site).href : undefined;
---

<html lang="ja">
<head>
  <HeadMeta colorScheme="light" />

  <BaseSEO title={title} description={description} />

  {/* The OG image is the newest photo: a variable-height JPEG, not the
      1200x630 PNG card the other apps use. */}
  <OpenGraph
    title={title}
    description={description}
    image={ogImageUrl}
    imageType="image/jpeg"
    imageWidth={image?.width}
    imageHeight={image?.height}
    siteName={SITE_NAME}
  />
  <TwitterCard
    title={title}
    description={description}
    image={ogImageUrl}
    site="@kkhys_"
    card={ogImageUrl ? "summary_large_image" : "summary"}
  />

  <Umami websiteId="547cd1e3-b5dd-461b-86af-96b35f86c302" domains="diary.kkhys.me" />

  <BlurLoadNoscript />
</head>
<body>
<main>
  <slot/>
</main>
</body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
    min-block-size: 100dvh;
    margin: 0;
  }

  main {
    flex: 1;
    inline-size: 100%;
    max-inline-size: 1440px;
    margin-inline: auto;
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }

  @media (width >= 768px) {
    main {
      inline-size: min(100% - 5rem, 1440px);
    }
  }
</style>
