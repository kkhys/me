---
import BlurImage from "@kkhys/ui/blur-image.astro";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  date: string;
  number: number;
  priority?: boolean | undefined;
}

const { src, alt, date, number, priority = false } = Astro.props;
---

<article class="entry">
  <div class="image-wrapper">
    <BlurImage
      src={src}
      alt={alt}
      width={1200}
      widths={[640, 900, 1200, 1800, 2400]}
      sizes="(min-width: 1200px) 1200px, (min-width: 768px) calc(100vw - 5rem), 100vw"
      priority={priority}
    />
  </div>
  <span class="meta">{date} / {number}</span>
</article>

<style>
  .entry {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .image-wrapper {
    overflow: clip;
    max-inline-size: 1200px;
  }

  .meta {
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    font-variant-numeric: tabular-nums;
    color: var(--c-sub);
    text-wrap: nowrap;
    align-self: flex-end;
    letter-spacing: 0.02em;
    padding-inline: var(--space-4);
  }

  @media (width >= 768px) {
    .entry {
      flex-direction: row;
      align-items: center;
      gap: var(--space-8);
    }

    .meta {
      padding-inline: 0;
      align-self: center;
    }
  }
</style>
