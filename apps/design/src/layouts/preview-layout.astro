---
import "#/styles/global.css";
import ThemeInit from "#/components/theme-init.astro";

/* Shell of the standalone demo documents under /preview: no sidebar, no
   `data-pagefind-body`, `noindex`. The demo sits centered on a plain
   canvas so a phone-width iframe shows only the component. */
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="ja">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="color-scheme" content="light dark"/>
  <ThemeInit />
  <meta name="robots" content="noindex"/>
  <title>{title}</title>
</head>
<body class="preview">
  <slot />
</body>
</html>

<style>
  /* Override the site shell: no sidebar columns, the demo centered on a
     plain canvas. Full-width demos (headers, footers) stretch across it. */
  body.preview {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: none;
    place-items: center;
    max-width: none;
    min-height: 100dvh;
    padding: var(--space-4);
    column-gap: 0;
  }

  body.preview > :global(*) {
    grid-row: auto;
    grid-column: 1;
    max-width: 100%;
  }
</style>
