---
import tokensCss from "@kkhys/styles/tokens.css?raw";
import uchuCss from "@kkhys/styles/uchu.css?raw";
import TokenSwatch from "#/components/token-swatch.astro";
import BaseLayout from "#/layouts/base-layout.astro";
import { filterByPrefix, parseCustomProperties } from "#/utils/tokens";

const semanticColors = filterByPrefix(parseCustomProperties(tokensCss), "--c-");
const uchu = parseCustomProperties(uchuCss);
const palette = uchu.filter(({ name }) => !name.endsWith("-raw"));
const rawVariants = uchu.filter(({ name }) => name.endsWith("-raw")).map(({ name }) => name);

interface PaletteStep {
  name: string;
  value: string;
  label: string;
}

/* Column per uchu step so every family lines up on the same scale; "•" is
   the unnumbered anchor color (yin / yang). */
const STEPS = ["1", "2", "3", "4", "5", "6", "7", "8", "9", "•"];

const families: { family: string; steps: PaletteStep[] }[] = [];
for (const { name, value } of palette) {
  const match = name.match(/^--uchu-(?<family>[a-z]+)(?:-(?<step>\d))?$/u);
  const family = match?.groups?.["family"];
  if (family === undefined) continue;
  const step: PaletteStep = { name, value, label: match?.groups?.["step"] ?? "•" };
  const group = families.find((entry) => entry.family === family);
  if (group) group.steps.push(step);
  else families.push({ family, steps: [step] });
}
---

<BaseLayout title="Colors" description="uchu OKLCH パレットとセマンティックカラートークン">
  <header class="page-header">
    <h1>Colors</h1>
    <p class="lead">
      色は <a href="https://github.com/NeverCease/uchu">uchu</a> の OKLCH パレットのサブセットだけを使う。
      アプリのコードが参照するのは用途名を持つセマンティックトークンで、
      各トークンは <code>light-dark()</code> で両テーマの値を持つ。
    </p>
  </header>

  <h2 id="semantic">Semantic colors <small>{semanticColors.length} tokens</small></h2>
  <p class="note">スワッチは左がライト、右がダークの解決値。L / D は <code>light-dark()</code> の各引数。</p>
  <div class="token-list">
    {semanticColors.map(({ name, value }) => <TokenSwatch name={name} value={value} />)}
  </div>

  <h2 id="palette">uchu palette <small>{palette.length} colors</small></h2>
  <p class="note">
    生のパレット値。原則としてアプリからは直接使わず、セマンティックトークンの材料にする。
    列は uchu の階調で、空きは未使用の色。チップにポインタを載せると oklch 値が出る。
  </p>
  <div class="matrix" style={`--cols: ${STEPS.length}`}>
    <div class="matrix-row matrix-head" aria-hidden="true">
      <span />
      {STEPS.map((step) => <span class="matrix-step">{step}</span>)}
    </div>
    {
      families.map(({ family, steps }) => (
        <div class="matrix-row">
          <code class="token-name">{family}</code>
          {STEPS.map((label) => {
            const step = steps.find((entry) => entry.label === label);
            return step ? (
              <span class="chip" title={`${step.name}: ${step.value}`}>
                <span class="chip-fill" style={`background: var(${step.name})`} />
              </span>
            ) : (
              <span class="chip chip--empty" />
            );
          })}
        </div>
      ))
    }
  </div>

  <h3>-raw variants</h3>
  <p class="note">
    透明度を後付けするために、<code>oklch()</code> の引数だけを持つ変種。
    <code>oklch(var(--uchu-yang-raw) / 10%)</code> のように使う。
  </p>
  <ul class="raw-list">
    {rawVariants.map((name) => <li><code class="token-name">{name}</code></li>)}
  </ul>
</BaseLayout>

<style>
  .token-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(26rem, 1fr));
    column-gap: var(--space-8);
  }

  .matrix {
    display: grid;
    gap: var(--space-2);
  }

  .matrix-row {
    display: grid;
    grid-template-columns: 5rem repeat(var(--cols), minmax(0, 1fr));
    align-items: center;
    gap: var(--space-2);
  }

  .matrix-head {
    padding-block-end: var(--space-1);
    border-bottom: 1px solid var(--c-border);
  }

  .matrix-step {
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    color: var(--c-sub);
    text-align: center;
  }

  .chip {
    display: block;
    width: 100%;
    max-width: 2.5rem;
    aspect-ratio: 1;
    margin-inline: auto;
    border-radius: var(--radius-sm);
    overflow: hidden;
    /* Hairline so near-background chips stay visible on both schemes. */
    box-shadow: inset 0 0 0 1px oklch(50% 0 0 / 0.25);
  }

  .chip--empty {
    box-shadow: inset 0 0 0 1px var(--c-border);
    opacity: 0.6;
  }

  .chip-fill {
    display: block;
    width: 100%;
    height: 100%;
  }

  .raw-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (width < 40rem) {
    .matrix-row {
      grid-template-columns: 3.5rem repeat(var(--cols), minmax(0, 1fr));
      gap: var(--space-1);
    }
  }
</style>
