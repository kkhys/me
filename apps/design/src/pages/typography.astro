---
import tokensCss from "@kkhys/styles/tokens.css?raw";
import BaseLayout from "#/layouts/base-layout.astro";
import { filterByPrefix, parseCustomProperties } from "#/utils/tokens";

const declarations = parseCustomProperties(tokensCss);
const fontSizes = filterByPrefix(declarations, "--fs-");
const fontWeights = filterByPrefix(declarations, "--fw-");
const lineHeights = filterByPrefix(declarations, "--lh-");
const fontMono = declarations.find(({ name }) => name === "--font-mono");

const SAMPLE = "あらゆる現実をすべて自分のほうへねじ曲げたのだ Sphinx of black quartz 0123";
const PARAGRAPH =
  "あらゆる現実をすべて自分のほうへねじ曲げたのだと思われるかもしれない。それでも、この文章はいつもの行送りで、いつもの幅に収まって読まれる。";
---

<BaseLayout title="Typography" description="フォントサイズ・ウェイト・行送りのスケール">
  <header class="page-header">
    <h1>Typography</h1>
    <p class="lead">
      本文は <code>system-ui, sans-serif</code>。見出しは <code>font-feature-settings: "palt"</code> で詰め、
      日本語の折り返しは BudouX(<a href="/components#budoux">Components</a>)に任せる。
      このサイトの本文は <code>--fs-sm</code>、注釈は <code>--fs-xs</code>。
    </p>
  </header>

  <h2 id="font-size">Font size <small>{fontSizes.length} steps</small></h2>
  <div class="rows">
    {
      fontSizes.map(({ name, value }) => (
        <div class="row">
          <code class="token-name">{name}</code>
          <code class="token-value">{value}</code>
          <p class="sample palt" style={`font-size: var(${name})`} data-budoux="off">
            {SAMPLE}
          </p>
        </div>
      ))
    }
  </div>

  <h2 id="font-weight">Font weight <small>{fontWeights.length} steps</small></h2>
  <div class="rows">
    {
      fontWeights.map(({ name, value }) => (
        <div class="row">
          <code class="token-name">{name}</code>
          <code class="token-value">{value}</code>
          <p class="sample" style={`font-weight: var(${name})`} data-budoux="off">
            {SAMPLE}
          </p>
        </div>
      ))
    }
  </div>

  <h2 id="line-height">Line height <small>{lineHeights.length} steps</small></h2>
  <div class="paragraphs">
    {
      lineHeights.map(({ name, value }) => (
        <figure class="paragraph">
          <figcaption>
            <code class="token-name">{name}</code>
            <code class="token-value">{value}</code>
          </figcaption>
          <p style={`line-height: var(${name})`}>{PARAGRAPH}</p>
        </figure>
      ))
    }
  </div>

  <h2 id="mono">Monospace</h2>
  {
    fontMono && (
      <div class="rows">
        <div class="row">
          <code class="token-name">{fontMono.name}</code>
          <code class="token-value">{fontMono.value}</code>
          <p class="sample" style="font-family: var(--font-mono)">
            const parsed = parseCustomProperties(css);
          </p>
        </div>
      </div>
    )
  }
</BaseLayout>

<style>
  .rows {
    display: grid;
  }

  .row {
    display: grid;
    grid-template-columns: 8rem 6rem minmax(0, 1fr);
    align-items: baseline;
    gap: var(--space-4);
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--c-border);
  }

  .sample {
    margin: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .paragraphs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-8);
  }

  .paragraph {
    margin: 0;
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }

  .paragraph figcaption {
    display: flex;
    gap: var(--space-3);
    padding-block-end: var(--space-2);
    border-bottom: 1px solid var(--c-border);
  }

  .paragraph p {
    margin: 0;
  }

  @media (width < 40rem) {
    .row {
      grid-template-columns: 1fr 1fr;
    }

    .sample {
      grid-column: 1 / -1;
    }
  }
</style>
