---
import GalleryThumb from "#/components/gallery-thumb.astro";
import SiteHeader from "#/components/site-header.astro";
import BaseLayout from "#/layouts/base-layout.astro";
import { loadFashionSeries, loadWorks } from "#/lib/gallery";
import { buildOgImage } from "#/lib/og-image";
import { fashionPath, fashionTransitionName, workPath, workTransitionName } from "#/utils/routes";
import { padNumber } from "#/utils/sheet-number";

const works = await loadWorks();
const series = await loadFashionSeries();

const featured = works[0];
const ogImage = featured ? await buildOgImage(featured.src) : undefined;
---

<BaseLayout image={ogImage}>
  <SiteHeader home />

  <section id="works" class="section">
    <h2 class="section-title">Works</h2>
    <ul class="grid grid-works" role="list">
      {works.map((work, i) => (
        <li>
          <GalleryThumb
            href={workPath(work.slug)}
            src={work.src}
            alt={work.title}
            title={work.title}
            meta={String(work.year)}
            transitionName={workTransitionName(work.slug)}
            width={460}
            widths={[320, 480, 640, 960]}
            sizes="(min-width: 1024px) 30vw, (min-width: 600px) 45vw, 100vw"
            priority={i < 3}
          />
        </li>
      ))}
    </ul>
  </section>

  <section id="fashion" class="section">
    <h2 class="section-title">Fashion Design</h2>
    <div class="series-list">
      {series.map((entry) => (
        <section class="series">
          <header class="series-header">
            <h3 class="series-title">{entry.title}</h3>
            <span class="series-year">{entry.year}</span>
          </header>
          <ul class="grid grid-fashion" role="list">
            {entry.images.map((image) => (
              <li>
                <GalleryThumb
                  href={fashionPath(entry.slug, image.number)}
                  src={image.src}
                  alt={`${entry.title} / ${padNumber(image.number)}`}
                  meta={padNumber(image.number)}
                  transitionName={fashionTransitionName(entry.slug, image.number)}
                  width={340}
                  widths={[240, 360, 480, 720]}
                  sizes="(min-width: 1024px) 22vw, (min-width: 600px) 30vw, 45vw"
                  framed
                />
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .section {
    display: flex;
    flex-direction: column;
    gap: clamp(var(--space-6), 3vw, 2.5rem);
    scroll-margin-block-start: 2rem;

    & + & {
      margin-block-start: clamp(4rem, 8vw, 6rem);
    }
  }

  .section-title,
  .series-header {
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    font-weight: var(--fw-normal);
    letter-spacing: 0.02em;
    margin: 0;
    padding-inline: var(--space-4);
  }

  .section-title {
    color: var(--c-sub);
    text-transform: uppercase;
  }

  .series-list {
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 5vw, 4rem);
  }

  .series {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .series-header {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
  }

  .series-title {
    font-size: inherit;
    font-weight: inherit;
    color: var(--c-text);
    margin: 0;
  }

  .series-year {
    font-variant-numeric: tabular-nums;
    color: var(--c-sub);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: var(--space-8) var(--space-4);
    padding-inline: var(--space-4);
    margin: 0;
  }

  .grid-works {
    --cols: 1;
  }

  .grid-fashion {
    --cols: 2;
  }

  @media (width >= 600px) {
    .grid-works {
      --cols: 2;
    }

    .grid-fashion {
      --cols: 3;
    }
  }

  @media (width >= 768px) {
    .section-title,
    .series-header,
    .grid {
      padding-inline: 0;
    }
  }

  @media (width >= 1024px) {
    .grid {
      gap: 2.5rem var(--space-6);
    }

    .grid-works {
      --cols: 3;
    }

    .grid-fashion {
      --cols: 4;
    }
  }
</style>
