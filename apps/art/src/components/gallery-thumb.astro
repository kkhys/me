---
import type { ImageMetadata } from "astro";
import BlurImage from "@kkhys/ui/blur-image.astro";

interface Props {
  href: string;
  src: ImageMetadata;
  alt: string;
  transitionName: string;
  width: number;
  widths: number[];
  sizes: string;
  title?: string | undefined;
  meta: string;
  framed?: boolean | undefined;
  priority?: boolean | undefined;
}

const { href, src, alt, transitionName, width, widths, sizes, title, meta, framed, priority } =
  Astro.props;
---

<a href={href} class="thumb">
  <BlurImage
    src={src}
    alt={alt}
    width={width}
    widths={widths}
    sizes={sizes}
    transitionName={transitionName}
    framed={framed}
    priority={priority}
  />
  <span class="caption">
    {title && <span class="title">{title}</span>}
    <span class="meta">{meta}</span>
  </span>
</a>

<style>
  .thumb {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    color: inherit;
    text-decoration: none;
  }

  .caption {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
  }

  .title {
    color: var(--c-text);
    text-wrap: balance;
  }

  .meta {
    color: var(--c-sub);
  }
</style>
