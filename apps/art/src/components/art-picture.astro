---
import { getImage, Picture } from "astro:assets";
import { blurLoadHandlers } from "@kkhys/ui/blur-load";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Rendered width in CSS px; the largest `widths` entry should be 2x this. */
  width: number;
  widths: number[];
  sizes: string;
  priority?: boolean | undefined;
}

const { src, alt, width, widths, sizes, priority = false } = Astro.props;

const blurryImage = await getImage({ src, width: 20 });
---

<div class="blur-load" style={`--bg-image: url(${blurryImage.src})`}>
  <Picture
    src={src}
    alt={alt}
    width={width}
    formats={["avif", "webp"]}
    quality={80}
    widths={widths}
    sizes={sizes}
    loading={priority ? "eager" : "lazy"}
    fetchpriority={priority ? "high" : undefined}
    {...blurLoadHandlers(".blur-load")}
  />
</div>

<style>
  .blur-load {
    overflow: clip;
    background: var(--bg-image) center / cover no-repeat;
    filter: blur(36px);
    transition: filter 250ms ease-in-out;

    &.image-loaded {
      background: none;
      filter: blur(0);
    }
  }
</style>
