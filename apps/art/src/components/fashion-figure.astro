---
import type { ImageMetadata } from "astro";
import BlurImage from "@kkhys/ui/blur-image.astro";
import type { FashionSheet } from "#/utils/fashion";
import { fashionTransitionName } from "#/utils/routes";
import { padNumber } from "#/utils/sheet-number";

interface Props {
  sheet: FashionSheet<ImageMetadata>;
}

const { series, image } = Astro.props.sheet;
const number = padNumber(image.number);
---

<figure class="sheet">
  <div class="image-wrapper">
    {/* The figcaption carries the text; an alt would be read twice. */}
    <BlurImage
      src={image.src}
      alt=""
      width={1200}
      widths={[640, 900, 1200, 1800, 2400]}
      sizes="(min-width: 768px) 68vh, 100vw"
      transitionName={fashionTransitionName(series.slug, image.number)}
      framed
      priority
    />
  </div>
  <figcaption class="caption">
    <h1 class="title">{series.title}</h1>
    <span class="meta">{number} / {series.year}</span>
  </figcaption>
</figure>

<style>
  .sheet {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin: 0;
  }

  .image-wrapper {
    max-inline-size: 1200px;
  }

  .caption {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    align-self: flex-end;
    padding-inline: var(--space-4);
    text-align: end;
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    letter-spacing: 0.02em;
  }

  .title {
    font-size: inherit;
    font-weight: var(--fw-normal);
    color: var(--c-text);
    margin: 0;
  }

  .meta {
    font-variant-numeric: tabular-nums;
    color: var(--c-sub);
  }

  @media (width >= 768px) {
    .sheet {
      flex-direction: row;
      align-items: center;
      gap: var(--space-8);
    }

    /* Portrait sheets: size by viewport height so one fits on screen, with
       a definite block-size so the box exists before the image decodes. The
       other two terms keep a 4:5 sheet inside its column — the main column
       is 100vw - 5rem, and .image-wrapper caps it at 1200px (× 1.25 = 1500px)
       — without container units: the wrapper is a flex item, and inline-size
       containment would collapse it to zero width. `sizes` uses 68vh, the
       width of a 4:5 sheet at 85vh. */
    .image-wrapper :global(.blur-load) {
      inline-size: fit-content;
    }

    .image-wrapper :global(img) {
      block-size: min(85dvh, 1500px, calc((100vw - 5rem) * 1.25));
      inline-size: auto;
    }

    .caption {
      align-self: center;
      padding-inline: 0;
      text-align: start;
    }
  }
</style>
