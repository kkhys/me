---
import "#/styles/global.css";
import Umami from "@kkhys/analytics/umami.astro";
import BlurLoadNoscript from "@kkhys/ui/blur-load-noscript.astro";
import BaseSEO from "@kkhys/seo/base-seo.astro";
import OpenGraph from "@kkhys/seo/open-graph.astro";
import TwitterCard from "@kkhys/seo/twitter-card.astro";
import { SITE_DESCRIPTION, SITE_NAME } from "#/config/site";
import type { OgImage } from "#/lib/og-image";

interface Props {
  title?: string | undefined;
  description?: string | undefined;
  image?: OgImage | undefined;
}

const { title = SITE_NAME, description = SITE_DESCRIPTION, image } = Astro.props;

const ogImageUrl = image ? new URL(image.src, Astro.site).href : undefined;
---

<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>

  {/* Cross-document view transition opt-in. Must be inline: Chromium checks it
      before the external stylesheet applies on a fresh load (see CLAUDE.md). */}
  <style is:inline>
    @media (prefers-reduced-motion: no-preference) {
      @view-transition {
        navigation: auto;
      }
    }
  </style>

  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="icon" href="/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">

  <BaseSEO title={title} description={description} />
  <link rel="sitemap" href="/sitemap-index.xml"/>

  {/* The OG image is a work: a variable-height JPEG, not the 1200x630 PNG
      card the other apps use. */}
  <OpenGraph
    title={title}
    description={description}
    image={ogImageUrl}
    imageType="image/jpeg"
    imageWidth={image?.width}
    imageHeight={image?.height}
    siteName={SITE_NAME}
  />
  <TwitterCard
    title={title}
    description={description}
    image={ogImageUrl}
    site="@kkhys_"
    card={ogImageUrl ? "summary_large_image" : "summary"}
  />

  {/* Cross-document view transitions snapshot the new page as soon as it
      renders; hold rendering until <main> is parsed so the image that
      should morph is already in the DOM. Pages are small, so this is cheap. */}
  <link rel="expect" href="#main" blocking="render">

  <Umami websiteId="e0b42f0b-54c0-41b1-a6ef-74cb97e1b778" domains="art.kkhys.me" />

  <BlurLoadNoscript />
</head>
<body>
<main id="main">
  <slot/>
</main>
</body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
    min-block-size: 100dvh;
    margin: 0;
  }

  main {
    flex: 1;
    inline-size: 100%;
    max-inline-size: 1440px;
    margin-inline: auto;
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }

  @media (width >= 768px) {
    main {
      inline-size: min(100% - 5rem, 1440px);
    }
  }
</style>
