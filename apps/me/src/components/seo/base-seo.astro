---
import BaseSEO from "@kkhys/seo/base-seo.astro";
import { resolveDescription, resolveTitle } from "#/config/site";

interface Props {
  title?: string | undefined;
  description?: string | undefined;
  noindex?: boolean | undefined;
}

const { title, description, noindex = false } = Astro.props;

const resolvedTitle = resolveTitle(title);
const resolvedDescription = resolveDescription(description);
---

<BaseSEO
  title={resolvedTitle}
  description={resolvedDescription}
  noindex={noindex}
  robotsNofollow
/>
