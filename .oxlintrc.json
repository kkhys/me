{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "jsx-a11y", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "error"
  },
  "rules": {
    // Arbitrary size/complexity metrics — conflict with Astro pages and large test files
    "eslint/max-lines-per-function": "off",
    "eslint/max-lines": "off",
    "import/max-dependencies": "off",
    // Side-effect imports (CSS, polyfills) are intentional
    "import/no-unassigned-import": "off",
    // Sequential awaits are intentional (ordered ops / pacing)
    "eslint/no-await-in-loop": "off",
    // Required args typed `T | undefined` must receive an explicit undefined
    "unicorn/no-useless-undefined": "off",
    "import/no-cycle": "error",
    "import/no-duplicates": "error",
    "unicorn/prefer-node-protocol": "error"
  },
  "ignorePatterns": [
    "**/*-content/**",
    "**/public/**",
    "**/.cache/**",
    "apps/trends/src/content/runs/**"
  ]
}
